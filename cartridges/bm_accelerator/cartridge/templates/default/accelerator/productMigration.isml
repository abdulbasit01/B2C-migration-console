<isdecorate template="application/MenuFrame">
<iscontent type="text/html" charset="UTF-8"/>
<link rel="stylesheet" href="${pdict.cssUrl}"/>
<script src="${pdict.attrPreflightJsUrl}"></script>
<style>
        .acc-tab {
            padding: 8px 20px;
            font-size: 14px;
            font-weight: 600;
            border: none;
            border-bottom: 3px solid transparent;
            background: none;
            cursor: pointer;
            color: #54698d;
        }
        .acc-tab--active {
            color: #0070d2;
            border-bottom-color: #0070d2;
        }
        .acc-info-box {
            background: #f4f6f9;
            border: 1px solid #dddbda;
            border-radius: 4px;
            padding: 16px 20px;
            font-size: 13px;
            line-height: 1.6;
            margin-bottom: 20px;
        }
        .acc-info-box strong { color: #16325c; }
        .acc-info-box code {
            background: #e0e5ee;
            padding: 1px 5px;
            border-radius: 3px;
            font-family: monospace;
            font-size: 12px;
        }
        .acc-field-error {
            display: none;
            color: #c62828;
            font-size: 12px;
            margin-top: 4px;
        }
        /* ---- Attribute pre-flight table ---- */
        .cm-attr-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }
        .cm-attr-table thead tr {
            background: #f4f6f9;
            border-bottom: 2px solid #dddbda;
        }
        .cm-attr-table th {
            padding: 9px 14px;
            text-align: left;
            font-size: 11px;
            font-weight: 700;
            color: #54698d;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }
        .cm-attr-table td {
            padding: 9px 14px;
            border-bottom: 1px solid #f0f2f8;
            color: #3e3e3c;
            vertical-align: middle;
        }
        .cm-attr-table tbody tr:last-child td { border-bottom: none; }
        .cm-attr-table tbody tr:hover { background: #f8f9fb; }
        .cm-attr-table td code {
            background: #eaf0fb;
            padding: 2px 7px;
            border-radius: 3px;
            font-family: monospace;
            font-size: 12px;
            color: #16325c;
            font-weight: 600;
        }
        .cm-attr-id-input {
            background: #eaf0fb;
            border: 1px solid #c8d6f0;
            border-radius: 3px;
            font-family: monospace;
            font-size: 12px;
            color: #16325c;
            font-weight: 600;
            padding: 3px 8px;
            width: 190px;
            outline: none;
            box-sizing: border-box;
        }
        .cm-attr-id-input:focus {
            border-color: #0070d2;
            background: #fff;
            box-shadow: 0 0 0 2px rgba(0,112,210,.15);
        }
        .cm-attr-type-select {
            font-size: 12px;
            padding: 4px 6px;
            border: 1px solid #c8d6f0;
            border-radius: 3px;
            background: #fff;
            color: #16325c;
            min-width: 140px;
            max-width: 180px;
        }
        .cm-btn {
            padding: 7px 16px;
            font-size: 13px;
            font-weight: 600;
            border-radius: 4px;
            cursor: pointer;
            border: 1px solid transparent;
            display: inline-block;
            line-height: 1.4;
            white-space: nowrap;
        }
        .cm-btn--primary {
            background: #0070d2;
            color: #fff;
            border-color: #005fb2;
        }
        .cm-btn--primary:hover { background: #005fb2; }
        .cm-btn--primary:disabled {
            background: #97c3ea;
            border-color: #97c3ea;
            cursor: default;
        }
        .cm-btn--revert {
            background: #fff;
            color: #c62828;
            border: 1px solid #f0b4b4;
            padding: 4px 12px;
            font-size: 12px;
            font-weight: 600;
            border-radius: 4px;
            cursor: pointer;
            white-space: nowrap;
        }
        .cm-btn--revert:hover { background: #fdecea; border-color: #c62828; }
        .cm-btn--revert:disabled {
            opacity: 1;
            cursor: default;
            color: #c8c8c8;
            border-color: #e8e8e8;
            background: #fafafa;
            pointer-events: none;
        }
    </style>
<div class="acc-page">
<div class="acc-shell">

    <isinclude template="accelerator/components/header"/>

    <div style="padding:10px 32px 0;">
        <a href="${pdict.dashboardUrl}" style="font-size:13px;color:#0070d2;text-decoration:none;">&larr; Back to Dashboard</a>
    </div>

    <section class="acc-section">
        <header class="acc-section__head">
            <h2>Product Data Migration &mdash; <span class="acc-highlight">Commercetools &rarr; SFCC</span></h2>
            <p style="font-size:14px;color:#54698d;margin-top:6px;max-width:640px;">
                Choose a migration mode below. <strong>Partial</strong> migrates specific products by CTP Product ID
                (suitable for testing / selective imports). <strong>Full</strong> migrates all products in batches
                via XML/WebDAV (suitable for production).
            </p>
        </header>

        <!-- ── Config row ── -->
        <div style="margin:24px 0 16px;">
            <div style="display:flex;align-items:flex-start;flex-wrap:wrap;gap:10px;">
                <label for="prod-catalog-id" style="font-weight:600;font-size:14px;white-space:nowrap;padding-top:6px;">
                    SFCC Catalog ID <span style="color:#c62828;">*</span>
                </label>
                <div>
                    <select id="prod-catalog-id" class="acc-form__input" style="width:260px;">
                        <option value="">Loading catalogs...</option>
                    </select>
                    <span id="prod-catalog-id-error" class="acc-field-error">Catalog ID is required.</span>
                </div>
                <button id="prod-check-btn" type="button" class="acc-btn acc-btn--ghost">Check Count</button>
                <span id="prod-count-badge" style="font-size:13px;color:#54698d;padding-top:6px;"></span>
            </div>
        </div>

        <!-- ── Attribute Pre-flight Panel ── -->
        <div id="prod-attr-preflight" style="margin:0 0 28px;border:1px solid #dddbda;border-radius:6px;overflow:hidden;">
            <div style="background:#f4f6f9;border-bottom:1px solid #dddbda;padding:11px 20px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                <span style="font-weight:700;font-size:14px;color:#16325c;">&#x26A1; Attribute Pre-flight Check</span>
                <button id="prod-check-attrs-btn" type="button" class="acc-btn acc-btn--ghost">Check CTP Attributes</button>
                <span id="prod-attr-check-msg" style="font-size:13px;color:#54698d;font-weight:600;"></span>
            </div>
            <div style="padding:14px 20px;">
                <p style="font-size:13px;color:#54698d;margin:0;">
                    Scans CTP product type definitions and checks whether matching
                    attributes exist on the SFCC <strong>Product</strong> system object.
                    Missing attributes can be created here before the migration runs.
                </p>
                <div id="prod-attr-results" style="display:none;margin-top:14px;"></div>
            </div>
        </div>

        <!-- ── Mode tabs ── -->
        <div style="display:flex;gap:0;border-bottom:2px solid #dddbda;margin-bottom:24px;">
            <button id="tab-partial" class="acc-tab acc-tab--active" type="button">Partial Migration</button>
            <button id="tab-full"    class="acc-tab"                 type="button">Full Migration (XML/WebDAV)</button>
        </div>

        <!-- ══════════════════════════════════════════════════════════════
             PANEL: PARTIAL MIGRATION
        ══════════════════════════════════════════════════════════════ -->
        <div id="panel-partial">

            <p style="font-size:13px;color:#54698d;margin:0 0 16px;">
                Fetches specific products from Commercetools by Product ID and imports them into SFCC.
                Useful for testing individual products before running a full migration.
            </p>

            <div style="margin-bottom:20px;">
                <label for="prod-ctp-ids" style="font-weight:600;font-size:14px;display:block;margin-bottom:6px;">
                    CTP Product IDs <span style="color:#c62828;">*</span>
                    <span style="font-weight:400;color:#54698d;font-size:13px;">(comma-separated)</span>
                </label>
                <textarea id="prod-ctp-ids" class="acc-form__input"
                          rows="3"
                          placeholder="e.g. a1b2c3d4-..., e5f6g7h8-..."
                          style="width:100%;max-width:680px;resize:vertical;font-family:monospace;font-size:12px;"></textarea>
                <span id="prod-ctp-ids-error" class="acc-field-error"></span>
            </div>

            <ul class="acc-phases" id="partial-phase-list" style="display:none;margin-bottom:24px;">
                <li class="acc-phases__item acc-phases__item--pending" id="partial-phase-products">
                    <div class="acc-phases__head">
                        <span>Migrating Products</span>
                        <span class="acc-phases__status" id="partial-status-products">pending</span>
                    </div>
                    <p class="acc-phases__detail" id="partial-detail-products"></p>
                    <div class="acc-progress">
                        <div class="acc-progress__bar" id="partial-bar-products" style="width:0%"></div>
                    </div>
                </li>
            </ul>

            <div id="partial-move-status" class="acc-callout acc-callout--info" style="display:none;margin-bottom:20px;"></div>

            <div class="acc-move-actions">
                <button type="button" id="partial-start-btn" class="acc-btn acc-btn--primary">
                    &#9654; Start Partial Migration
                </button>
                <span id="partial-move-overall" style="margin-left:14px;font-size:13px;color:#54698d;"></span>
            </div>

        </div><!-- /panel-partial -->

        <!-- ══════════════════════════════════════════════════════════════
             PANEL: FULL MIGRATION
        ══════════════════════════════════════════════════════════════ -->
        <div id="panel-full" style="display:none;">

            <p style="font-size:13px;color:#54698d;margin:0 0 16px;">
                Fetches all products from Commercetools in batches of 500, builds SFCC catalog XML,
                and uploads to WebDAV. After upload, import the XML files in Business Manager.
            </p>

            <ul class="acc-phases" id="full-phase-list" style="display:none;margin-bottom:24px;">
                <li class="acc-phases__item acc-phases__item--pending" id="full-phase-build">
                    <div class="acc-phases__head">
                        <span>Phase 1 &mdash; Build &amp; Upload XML to WebDAV</span>
                        <span class="acc-phases__status" id="full-status-build">pending</span>
                    </div>
                    <p class="acc-phases__detail" id="full-detail-build"></p>
                    <div class="acc-progress">
                        <div class="acc-progress__bar" id="full-bar-build" style="width:0%"></div>
                    </div>
                </li>
                <li class="acc-phases__item acc-phases__item--pending" id="full-phase-import">
                    <div class="acc-phases__head">
                        <span>Phase 2 &mdash; Import in Business Manager</span>
                        <span class="acc-phases__status" id="full-status-import">waiting</span>
                    </div>
                    <p class="acc-phases__detail" id="full-detail-import">Complete Phase 1 first.</p>
                    <div id="full-phase2-instructions" style="display:none;margin-top:12px;">
                        <div class="acc-info-box" style="margin:0;">
                            XML files uploaded to <code>/Impex/${pdict.impexPath}/</code>
                            (e.g. <code>product-YYYYMMDD-v001.xml</code>)<br/><br/>
                            <strong>To import in BM:</strong><br/>
                            <strong>Administration &rarr; Operations &rarr; Import &amp; Export</strong><br/>
                            &rarr; Select <strong>Catalog</strong> &rarr; choose the uploaded XML file &rarr; Import<br/><br/>
                            <em>Or run a BM Job with step type <code>sfcc.catalog.catalog-import</code>
                            pointing to <code>/Impex/${pdict.impexPath}/</code>.</em>
                        </div>
                    </div>
                </li>
            </ul>

            <div id="full-move-status" class="acc-callout acc-callout--info" style="display:none;margin-bottom:20px;"></div>

            <div class="acc-move-actions">
                <button type="button" id="full-start-btn" class="acc-btn acc-btn--primary">
                    &#9654; Start Full Migration
                </button>
                <span id="full-move-overall" style="margin-left:14px;font-size:13px;color:#54698d;"></span>
            </div>

        </div><!-- /panel-full -->

    </section>
</div>

<script>
(function () {
    var COUNT_URL        = '${pdict.countUrl}';
    var PARTIAL_URL      = '${pdict.partialUrl}';
    var FULL_BATCH_URL   = '${pdict.fullBatchUrl}';
    var CHECK_ATTRS_URL  = '${pdict.checkAttrsUrl}';
    var CREATE_ATTRS_URL = '${pdict.createAttrsUrl}';
    var DELETE_ATTR_URL  = '${pdict.deleteAttrUrl}';
    var CATALOGS_URL     = '${pdict.catalogsUrl}';
    var DATA_WIZARD_ENTRY_URL = '${pdict.dataWizardEntryUrl}';

    // ── Load SFCC Catalogs into dropdown ─────────────────────────────────────
    var catalogSelect = document.getElementById('prod-catalog-id');
    (function loadCatalogs() {
        var xhr = new XMLHttpRequest();
        xhr.open('GET', CATALOGS_URL, true);
        xhr.onreadystatechange = function () {
            if (xhr.readyState !== 4) return;
            var data;
            try { data = JSON.parse(xhr.responseText); } catch (e) { data = { ok: false }; }
            catalogSelect.innerHTML = '';
            if (!data.ok || !data.catalogs || !data.catalogs.length) {
                var opt = document.createElement('option');
                opt.value = '';
                opt.textContent = data.ok ? 'No catalogs found' : 'Error loading catalogs';
                catalogSelect.appendChild(opt);
                return;
            }
            var blank = document.createElement('option');
            blank.value = '';
            blank.textContent = 'Select a Catalog';
            catalogSelect.appendChild(blank);
            for (var i = 0; i < data.catalogs.length; i++) {
                var o = document.createElement('option');
                o.value = data.catalogs[i].id;
                o.textContent = data.catalogs[i].id;
                catalogSelect.appendChild(o);
            }
        };
        xhr.send();
    }());

    var checkBtn    = document.getElementById('prod-check-btn');
    var countBadge  = document.getElementById('prod-count-badge');

    // ── Tab switching ────────────────────────────────────────────────────────

    var tabPartial   = document.getElementById('tab-partial');
    var tabFull      = document.getElementById('tab-full');
    var panelPartial = document.getElementById('panel-partial');
    var panelFull    = document.getElementById('panel-full');

    tabPartial.addEventListener('click', function () {
        tabPartial.className       = 'acc-tab acc-tab--active';
        tabFull.className          = 'acc-tab';
        panelPartial.style.display = '';
        panelFull.style.display    = 'none';
    });

    tabFull.addEventListener('click', function () {
        tabFull.className          = 'acc-tab acc-tab--active';
        tabPartial.className       = 'acc-tab';
        panelFull.style.display    = '';
        panelPartial.style.display = 'none';
    });

    // ── Shared helpers ───────────────────────────────────────────────────────

    function post(url, params, onDone) {
        var req = new XMLHttpRequest();
        req.open('POST', url, true);
        req.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        req.onreadystatechange = function () {
            if (req.readyState !== 4) return;
            var data;
            try { data = JSON.parse(req.responseText); } catch (e) { data = { ok: false, error: 'Parse error' }; }
            onDone(data);
        };
        req.send(params);
    }

    function setPhase(prefix, id, state, detail, pct) {
        var li  = document.getElementById(prefix + '-phase-' + id);
        var st  = document.getElementById(prefix + '-status-' + id);
        var det = document.getElementById(prefix + '-detail-' + id);
        var bar = document.getElementById(prefix + '-bar-' + id);
        if (!li) return;
        li.className  = 'acc-phases__item acc-phases__item--' + state;
        if (st)  st.textContent  = state;
        if (det && detail !== null) det.textContent = detail || '';
        if (bar) bar.style.width = (pct || 0) + '%';
    }

    function showError(inputId, errorId, msg) {
        var el  = document.getElementById(inputId);
        var err = document.getElementById(errorId);
        if (el)  el.style.borderColor = '#c62828';
        if (err) { err.textContent = msg; err.style.display = 'block'; }
    }

    function clearError(inputId, errorId) {
        var el  = document.getElementById(inputId);
        var err = document.getElementById(errorId);
        if (el)  el.style.borderColor = '';
        if (err) { err.style.display = 'none'; }
    }

    document.getElementById('prod-ctp-ids').addEventListener('input', function () {
        clearError('prod-ctp-ids', 'prod-ctp-ids-error');
    });

    // ════════════════════════════════════════════════════════════════════════
    // ATTRIBUTE PRE-FLIGHT
    // ════════════════════════════════════════════════════════════════════════

    var checkAttrsBtn = document.getElementById('prod-check-attrs-btn');
    var attrCheckMsg  = document.getElementById('prod-attr-check-msg');
    var attrResults   = document.getElementById('prod-attr-results');

    var pendingMissing = [];

    function handleAttrCheckResult(missing) {
        pendingMissing     = missing;
        attrResults.innerHTML = '';

        if (!missing.length) {
            attrResults.innerHTML = '<p style="color:#2e7d32;font-size:13px;margin:0;">'
                + '&#10003; All CTP product attributes already exist in SFCC &#8212; no action needed.</p>';
            attrResults.style.display = 'block';
            attrCheckMsg.textContent  = 'All attributes in sync.';
            attrCheckMsg.style.color  = '#2e7d32';
            return;
        }

        attrCheckMsg.textContent = missing.length + ' missing.';
        attrCheckMsg.style.color = '#c62828';

        var html = '<p style="font-size:13px;color:#54698d;margin:0 0 10px;">'
            + missing.length + ' attribute(s) found in CTP but missing in SFCC. '
            + 'Select the ones you want to create:</p>';

        html += '<div style="border:1px solid #e0e5ee;border-radius:4px;overflow:hidden;">'
            + '<table class="cm-attr-table">'
            + '<thead><tr>'
            + '<th style="width:36px;"><input type="checkbox" id="prod-attr-select-all" checked/></th>'
            + '<th>Attribute ID</th>'
            + '<th>Label</th>'
            + '<th>CTP Type</th>'
            + '<th>SFCC Type</th>'
            + '<th style="width:90px;">Action</th>'
            + '</tr></thead><tbody>';

        for (var i = 0; i < missing.length; i++) {
            var m = missing[i];
            html += '<tr id="prod-attr-row-' + i + '">'
                + '<td style="text-align:center;"><input type="checkbox" class="prod-attr-cb" data-idx="' + i + '" checked/></td>'
                + '<td><input type="text" class="cm-attr-id-input" data-idx="' + i + '" value="' + m.id + '" title="Edit attribute ID"/></td>'
                + '<td>' + (m.label || m.id) + '</td>'
                + '<td style="color:#8a9ab8;">' + m.ctpType + '</td>'
                + '<td>' + window.AccAttrPreflight.sfccTypeSelectHtml(m, i) + '</td>'
                + '<td><button type="button" class="cm-btn--revert prod-attr-revert-btn" data-idx="' + i + '" disabled title="Create the attribute first to enable revert">Revert</button></td>'
                + '</tr>';
        }
        html += '</tbody></table></div>';

        html += '<div style="margin-top:14px;display:flex;align-items:center;gap:12px;">'
            + '<button type="button" id="prod-create-attrs-btn" class="cm-btn cm-btn--primary">&#10003; Create Selected Attributes</button>'
            + '<span id="prod-create-attrs-msg" style="font-size:13px;color:#54698d;"></span>'
            + '</div>';

        attrResults.innerHTML     = html;
        attrResults.style.display = 'block';

        document.getElementById('prod-attr-select-all').addEventListener('change', function () {
            var cbs = document.querySelectorAll('.prod-attr-cb');
            for (var c = 0; c < cbs.length; c++) { cbs[c].checked = this.checked; }
        });

        var revertBtns = document.querySelectorAll('.prod-attr-revert-btn');
        for (var rb = 0; rb < revertBtns.length; rb++) {
            revertBtns[rb].addEventListener('click', function () {
                var btn     = this;
                var idx     = parseInt(btn.getAttribute('data-idx'), 10);
                var idInput = document.querySelector('.cm-attr-id-input[data-idx="' + idx + '"]');
                var attrId  = idInput ? idInput.value.trim() : (pendingMissing[idx] || {}).id;
                if (!attrId) return;
                btn.disabled    = true;
                btn.textContent = 'Reverting...';
                post(DELETE_ATTR_URL, 'attrId=' + encodeURIComponent(attrId), function (res) {
                    if (res.ok) {
                        btn.textContent       = 'Reverted';
                        btn.style.color       = '#2e7d32';
                        btn.style.borderColor = '#a5d6a7';
                        btn.style.background  = '#e8f5e9';
                        var row = document.getElementById('prod-attr-row-' + idx);
                        if (row) row.style.opacity = '0.5';
                    } else {
                        btn.disabled    = false;
                        btn.textContent = 'Revert';
                        var msgEl = document.getElementById('prod-create-attrs-msg');
                        if (msgEl) { msgEl.textContent = 'Revert failed: ' + (res.error || 'Unknown error'); msgEl.style.color = '#c62828'; }
                    }
                });
            });
        }

        document.getElementById('prod-create-attrs-btn').addEventListener('click', function () {
            var selected        = [];
            var selectedIndices = [];
            var cbs = document.querySelectorAll('.prod-attr-cb');
            for (var c = 0; c < cbs.length; c++) {
                if (cbs[c].checked) {
                    var idx      = parseInt(cbs[c].getAttribute('data-idx'), 10);
                    var orig     = pendingMissing[idx];
                    var idInput  = document.querySelector('.cm-attr-id-input[data-idx="' + idx + '"]');
                    var editedId = (idInput && idInput.value.trim()) ? idInput.value.trim() : orig.id;
                    selected.push({
                        id: editedId,
                        label: orig.label,
                        ctpType: orig.ctpType,
                        sfccType: window.AccAttrPreflight.readSfccType(idx, orig.sfccType)
                    });
                    selectedIndices.push(idx);
                }
            }
            if (!selected.length) {
                document.getElementById('prod-create-attrs-msg').textContent = 'Select at least one attribute.';
                return;
            }
            var btn = document.getElementById('prod-create-attrs-btn');
            var msg = document.getElementById('prod-create-attrs-msg');
            if (btn) { btn.disabled = true; btn.textContent = 'Creating...'; }
            if (msg) { msg.textContent = ''; }
            post(CREATE_ATTRS_URL, 'attrs=' + encodeURIComponent(JSON.stringify(selected)), function (data) {
                if (!data.ok) {
                    if (btn) { btn.disabled = false; btn.textContent = 'Retry'; }
                    if (msg) { msg.textContent = 'Error: ' + (data.error || 'Failed'); msg.style.color = '#c62828'; }
                    return;
                }
                var r    = data.result || {};
                var text = r.created + ' created' + (r.failed ? ', ' + r.failed + ' failed' : '') + '.';
                if (r.errors && r.errors.length) text += ' ' + r.errors[0];
                if (btn) { btn.disabled = true; btn.textContent = '&#10003; Done'; }
                if (msg) { msg.textContent = text; msg.style.color = r.failed ? '#c62828' : '#2e7d32'; }
                for (var ri = 0; ri < selectedIndices.length; ri++) {
                    var rv = document.querySelector('.prod-attr-revert-btn[data-idx="' + selectedIndices[ri] + '"]');
                    if (rv) { rv.disabled = false; rv.title = ''; }
                }
            });
        });
    }

    checkAttrsBtn.addEventListener('click', function () {
        checkAttrsBtn.disabled    = true;
        checkAttrsBtn.textContent = 'Checking...';
        attrCheckMsg.textContent  = '';
        attrResults.style.display = 'none';

        post(CHECK_ATTRS_URL, '', function (data) {
            checkAttrsBtn.disabled    = false;
            checkAttrsBtn.textContent = 'Re-check';
            if (!data.ok) {
                attrCheckMsg.textContent = 'Error: ' + (data.error || 'Check failed');
                attrCheckMsg.style.color = '#c62828';
                return;
            }
            handleAttrCheckResult(data.missing || []);
        });
    });

    // ── Check Count ──────────────────────────────────────────────────────────

    checkBtn.addEventListener('click', function () {
        countBadge.textContent = 'Checking...';
        countBadge.style.color = '#54698d';
        post(COUNT_URL, '', function (data) {
            if (data.ok) {
                countBadge.textContent = data.total.toLocaleString() + ' product(s) in CTP';
                countBadge.style.color = '#2e7d32';
            } else {
                countBadge.textContent = 'Error: ' + (data.error || 'Connection failed');
                countBadge.style.color = '#c62828';
            }
        });
    });

    // ════════════════════════════════════════════════════════════════════════
    // PARTIAL MIGRATION
    // ════════════════════════════════════════════════════════════════════════

    var partialStartBtn = document.getElementById('partial-start-btn');
    var partialOverall  = document.getElementById('partial-move-overall');
    var partialStatus   = document.getElementById('partial-move-status');
    var partialPhases   = document.getElementById('partial-phase-list');
    var partialRunning  = false;
    var partialBuilt    = 0;
    var partialFailed   = 0;

    function runPartialById(ids, index) {
        if (index >= ids.length) {
            var state = (partialFailed > 0 && partialBuilt === 0) ? 'error'
                      : (partialFailed > 0) ? 'warning' : 'done';
            setPhase('partial', 'products', state,
                partialBuilt + ' imported' + (partialFailed ? ', ' + partialFailed + ' failed' : ''), 100);
            finalizePartial();
            return;
        }

        var ctpId = ids[index].trim();
        var pct   = Math.round((index / ids.length) * 100);
        setPhase('partial', 'products', 'active',
            (index + 1) + ' / ' + ids.length + ' — ' + ctpId, pct);
        partialOverall.textContent = partialBuilt + ' imported'
            + (partialFailed ? ', ' + partialFailed + ' failed' : '');

        post(PARTIAL_URL, 'ctpId=' + encodeURIComponent(ctpId), function (data) {
            if (!data.ok) {
                partialFailed++;
            } else {
                partialBuilt += (data.built || 1);
                partialFailed += (data.failed || 0);
            }
            runPartialById(ids, index + 1);
        });
    }

    function finalizePartial() {
        partialRunning               = false;
        partialStartBtn.disabled     = false;
        partialStartBtn.textContent  = 'Migration Complete';
        partialStatus.style.display  = 'block';
        partialStatus.className      = partialFailed > 0
            ? 'acc-callout acc-callout--warning'
            : 'acc-callout acc-callout--success';
        partialStatus.textContent    = 'Done — '
            + partialBuilt + ' product(s) imported.'
            + (partialFailed ? ' ' + partialFailed + ' failed — check BM logs.' : '');
    }

    partialStartBtn.addEventListener('click', function () {
        var rawIds = document.getElementById('prod-ctp-ids').value.trim();
        if (!rawIds) {
            showError('prod-ctp-ids', 'prod-ctp-ids-error', 'CTP Product IDs are required.');
            return;
        }
        var ids = rawIds.split(',').map(function (s) { return s.trim(); }).filter(function (s) { return s.length > 0; });
        if (!ids.length) {
            showError('prod-ctp-ids', 'prod-ctp-ids-error', 'Enter at least one valid CTP Product ID.');
            return;
        }
        clearError('prod-ctp-ids', 'prod-ctp-ids-error');
        if (partialRunning) return;

        partialRunning  = true;
        partialBuilt    = 0;
        partialFailed   = 0;
        partialStartBtn.disabled    = true;
        partialStartBtn.textContent = 'Running...';
        partialStatus.style.display = 'none';
        partialOverall.textContent  = '';
        partialPhases.style.display = 'block';
        setPhase('partial', 'products', 'pending', '', 0);
        runPartialById(ids, 0);
    });

    // ════════════════════════════════════════════════════════════════════════
    // FULL MIGRATION
    // ════════════════════════════════════════════════════════════════════════

    var fullStartBtn = document.getElementById('full-start-btn');
    var fullOverall  = document.getElementById('full-move-overall');
    var fullStatus   = document.getElementById('full-move-status');
    var fullPhases   = document.getElementById('full-phase-list');
    var fullRunning  = false;
    var fullFinished = false;
    var fullBuilt    = 0;
    var fullFailed   = 0;

    function goToDataWizard() {
        window.location.href = DATA_WIZARD_ENTRY_URL;
    }

    function runFullBatch(offset, total) {
        var pct = (total > 0) ? Math.round((offset / total) * 100) : 0;
        setPhase('full', 'build', 'active',
            offset + ' / ' + (total || '?') + ' — '
            + fullBuilt + ' migrated' + (fullFailed ? ', ' + fullFailed + ' failed' : ''), pct);

        post(FULL_BATCH_URL, 'offset=' + offset, function (data) {
            if (!data.ok) {
                setPhase('full', 'build', 'error', data.error || 'Failed', pct);
                finalizeFull(false);
                return;
            }
            fullBuilt  += (data.built  || 0);
            fullFailed += (data.failed || 0);
            fullOverall.textContent = fullBuilt + ' migrated'
                + (fullFailed ? ' — ' + fullFailed + ' failed' : '');

            if (!data.done) {
                runFullBatch(data.nextOffset, data.total);
            } else {
                var st = (fullFailed > 0 && fullBuilt === 0) ? 'error' : (fullFailed > 0) ? 'warning' : 'done';
                setPhase('full', 'build', st,
                    fullBuilt + ' product(s) migrated'
                    + (fullFailed ? ' — ' + fullFailed + ' failed' : ''), 100);
                finalizeFull(true);
            }
        });
    }

    function finalizeFull(success) {
        fullRunning              = false;
        fullStartBtn.disabled    = false;
        if (success) {
            fullFinished             = true;
            fullStartBtn.textContent = 'Finish';
            fullStatus.style.display = 'block';
            fullStatus.className   = fullFailed > 0 ? 'acc-callout acc-callout--warning' : 'acc-callout acc-callout--success';
            fullStatus.textContent = fullBuilt + ' product(s) written to XML.'
                + (fullFailed ? ' ' + fullFailed + ' skipped.' : '')
                + ' Now import the XML files in BM (see Phase 2 below).';
            setPhase('full', 'import', 'active', 'Ready — follow import instructions below.', null);
            var inst = document.getElementById('full-phase2-instructions');
            if (inst) inst.style.display = 'block';
        } else {
            fullFinished             = false;
            fullStartBtn.textContent = 'Build Failed';
            fullStatus.style.display = 'block';
            fullStatus.className   = 'acc-callout acc-callout--warning';
            fullStatus.textContent = 'Build failed — check server logs.';
        }
    }

    fullStartBtn.addEventListener('click', function () {
        if (fullFinished) {
            goToDataWizard();
            return;
        }
        if (fullRunning) return;
        fullFinished = false;
        fullRunning  = true;
        fullBuilt    = 0;
        fullFailed   = 0;
        fullStartBtn.disabled    = true;
        fullStartBtn.textContent = 'Migrating...';
        fullStatus.style.display = 'none';
        fullOverall.textContent  = '';
        fullPhases.style.display = 'block';
        setPhase('full', 'build',   'pending', '', 0);
        setPhase('full', 'import',  'pending', 'Waiting for Phase 1...', 0);
        runFullBatch(0, 0);
    });

}());
</script>

</div>
</div>
</isdecorate>
