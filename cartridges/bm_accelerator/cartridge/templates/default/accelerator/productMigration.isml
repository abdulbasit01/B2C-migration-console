<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>${pdict.title}</title>
    <link rel="stylesheet" href="${pdict.cssUrl}"/>
    <style>
        .acc-info-box {
            background: #f4f6f9;
            border: 1px solid #dddbda;
            border-radius: 4px;
            padding: 16px 20px;
            font-size: 13px;
            line-height: 1.6;
            margin-bottom: 20px;
        }
        .acc-info-box strong { color: #16325c; }
        .acc-info-box code {
            background: #e0e5ee;
            padding: 1px 5px;
            border-radius: 3px;
            font-family: monospace;
            font-size: 12px;
        }
        .acc-field-error {
            display: none;
            color: #c62828;
            font-size: 12px;
            margin-top: 4px;
        }
        .acc-config-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            margin: 24px 0 20px;
        }
        .acc-config-field {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .acc-config-field label {
            font-weight: 600;
            font-size: 13px;
            color: #16325c;
        }
    </style>
</head>
<body class="acc-page">
<div class="acc-shell">

    <isinclude template="accelerator/components/header"/>

    <div style="padding:10px 32px 0;">
        <a href="${pdict.dashboardUrl}" style="font-size:13px;color:#0070d2;text-decoration:none;">&larr; Back to Dashboard</a>
    </div>

    <section class="acc-section">
        <header class="acc-section__head">
            <h2>Product Catalog Migration &mdash; <span class="acc-highlight">Commercetools &rarr; SFCC</span></h2>
            <p style="font-size:14px;color:#54698d;margin-top:6px;max-width:640px;">
                Fetches products from Commercetools in batches of 500, builds SFCC catalog XML (products, pricebook, inventory),
                and uploads via WebDAV. Then triggers a BM import job to load the data into SFCC.
            </p>
        </header>

        <!-- ── SFCC Config ── -->
        <div class="acc-config-grid">
            <div class="acc-config-field">
                <label for="prod-catalog-id">Catalog ID <span style="color:#c62828;">*</span></label>
                <input id="prod-catalog-id" type="text" class="acc-form__input"
                       placeholder="e.g. storefront-catalog-en"
                       value="${pdict.catalogId}"
                       style="width:240px;"/>
                <span id="prod-catalog-error" class="acc-field-error">Catalog ID is required.</span>
            </div>
            <div class="acc-config-field">
                <label for="prod-pricebook-id">Pricebook ID</label>
                <input id="prod-pricebook-id" type="text" class="acc-form__input"
                       value="${pdict.pricebookId}"
                       style="width:200px;"/>
            </div>
            <div class="acc-config-field">
                <label for="prod-currency">Currency</label>
                <input id="prod-currency" type="text" class="acc-form__input"
                       value="${pdict.currency}"
                       style="width:100px;"/>
            </div>
            <div class="acc-config-field">
                <label for="prod-inventory-id">Inventory List ID</label>
                <input id="prod-inventory-id" type="text" class="acc-form__input"
                       value="${pdict.inventoryListId}"
                       style="width:200px;"/>
            </div>
            <div class="acc-config-field" style="justify-content:flex-end;">
                <label style="visibility:hidden;">-</label>
                <div style="display:flex;align-items:center;gap:10px;">
                    <button id="prod-check-btn" type="button" class="acc-btn acc-btn--ghost">Check Count</button>
                    <span id="prod-count-badge" style="font-size:13px;color:#54698d;"></span>
                </div>
            </div>
        </div>

        <!-- ── How it works ── -->
        <div class="acc-info-box">
            <strong>How Product Migration works:</strong><br/>
            <strong>Phase 1</strong> fetches products from Commercetools in batches of 500, builds SFCC catalog XML,
            pricebook XML, and inventory XML, and uploads each file to WebDAV at
            <code>/Impex/src/instance/ctp-product-migration/</code>.<br/>
            <strong>Phase 2</strong> triggers a BM job to import the catalog XML. Pricebook and inventory files
            must be imported manually via <strong>BM &rarr; Merchant Tools &rarr; Products and Catalogs &rarr;
            Import &amp; Export</strong>.
        </div>

        <!-- ── Phase progress bars ── -->
        <ul class="acc-phases" id="prod-phase-list" style="display:none;margin-bottom:24px;">
            <li class="acc-phases__item acc-phases__item--pending" id="prod-phase-build">
                <div class="acc-phases__head">
                    <span>Phase 1 &mdash; Build &amp; Upload XML Files</span>
                    <span class="acc-phases__status" id="prod-status-build">pending</span>
                </div>
                <p class="acc-phases__detail" id="prod-detail-build"></p>
                <div class="acc-progress">
                    <div class="acc-progress__bar" id="prod-bar-build" style="width:0%"></div>
                </div>
            </li>
            <li class="acc-phases__item acc-phases__item--pending" id="prod-phase-import">
                <div class="acc-phases__head">
                    <span>Phase 2 &mdash; BM Catalog Import Job</span>
                    <span class="acc-phases__status" id="prod-status-import">pending</span>
                </div>
                <p class="acc-phases__detail" id="prod-detail-import">Waiting for Phase 1&hellip;</p>
                <div id="prod-phase2-controls" style="display:none;margin-top:14px;">
                    <p style="font-size:13px;color:#54698d;margin:0 0 10px;">
                        XML files are ready in <code>/Impex/src/instance/ctp-product-migration/</code>.
                        Enter the BM Job ID below and click <strong>Trigger</strong> to run the catalog import automatically.
                        Pricebook and inventory must be imported manually via BM.
                    </p>
                    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                        <label for="prod-job-id" style="font-size:13px;font-weight:600;white-space:nowrap;">BM Job ID:</label>
                        <input id="prod-job-id" type="text" class="acc-form__input"
                               value="CTP-Product-Import"
                               style="width:220px;font-family:monospace;font-size:12px;"/>
                        <button type="button" id="prod-trigger-btn" class="acc-btn acc-btn--secondary">
                            &#9658; Trigger Import Job
                        </button>
                    </div>
                    <div id="prod-job-status-msg" style="margin-top:8px;font-size:13px;color:#54698d;"></div>
                </div>
            </li>
        </ul>

        <!-- ── Result callout ── -->
        <div id="prod-move-status" class="acc-callout acc-callout--info" style="display:none;margin-bottom:20px;"></div>

        <!-- ── Controls ── -->
        <div class="acc-move-actions">
            <button type="button" id="prod-start-btn" class="acc-btn acc-btn--primary">
                &#9654; Start Migration
            </button>
            <span id="prod-move-overall" style="margin-left:14px;font-size:13px;color:#54698d;"></span>
        </div>

    </section>
</div>

<script>
(function () {
    var COUNT_URL      = '${pdict.countUrl}';
    var BATCH_URL      = '${pdict.fullBatchUrl}';
    var TRIGGER_URL    = '${pdict.triggerJobUrl}';
    var STATUS_URL     = '${pdict.jobStatusUrl}';
    var SAVE_CFG_URL   = '${pdict.saveConfigUrl}';

    var catalogEl   = document.getElementById('prod-catalog-id');
    var pricebookEl = document.getElementById('prod-pricebook-id');
    var currencyEl  = document.getElementById('prod-currency');
    var inventoryEl = document.getElementById('prod-inventory-id');
    var checkBtn    = document.getElementById('prod-check-btn');
    var countBadge  = document.getElementById('prod-count-badge');
    var startBtn    = document.getElementById('prod-start-btn');
    var overallEl   = document.getElementById('prod-move-overall');
    var statusBox   = document.getElementById('prod-move-status');
    var phaseList   = document.getElementById('prod-phase-list');

    var built          = 0;
    var failed         = 0;
    var files          = 0;
    var pricesBuilt    = 0;
    var inventoryBuilt = 0;
    var running        = false;

    function post(url, params, onDone) {
        var req = new XMLHttpRequest();
        req.open('POST', url, true);
        req.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        req.onreadystatechange = function () {
            if (req.readyState !== 4) return;
            var data;
            try { data = JSON.parse(req.responseText); } catch (e) { data = { ok: false, error: 'Parse error' }; }
            onDone(data);
        };
        req.send(params);
    }

    function setPhase(id, state, detail, pct) {
        var li  = document.getElementById('prod-phase-' + id);
        var st  = document.getElementById('prod-status-' + id);
        var det = document.getElementById('prod-detail-' + id);
        var bar = document.getElementById('prod-bar-' + id);
        if (!li) return;
        li.className  = 'acc-phases__item acc-phases__item--' + state;
        if (st)  st.textContent  = state;
        if (det && detail !== null) det.textContent = detail || '';
        if (bar) bar.style.width = (pct || 0) + '%';
    }

    function showCatalogError(msg) {
        var err = document.getElementById('prod-catalog-error');
        catalogEl.style.borderColor = '#c62828';
        if (err) { err.textContent = msg; err.style.display = 'block'; }
    }

    function clearCatalogError() {
        var err = document.getElementById('prod-catalog-error');
        catalogEl.style.borderColor = '';
        if (err) { err.style.display = 'none'; }
    }

    catalogEl.addEventListener('input', clearCatalogError);

    // ── Check Count ──────────────────────────────────────────────────────────

    checkBtn.addEventListener('click', function () {
        countBadge.textContent = 'Checking...';
        countBadge.style.color = '#54698d';
        post(COUNT_URL, '', function (data) {
            if (data.ok) {
                countBadge.textContent = data.total.toLocaleString() + ' product(s) in CTP';
                countBadge.style.color = '#2e7d32';
            } else {
                countBadge.textContent = 'Error: ' + (data.error || 'Connection failed');
                countBadge.style.color = '#c62828';
            }
        });
    });

    // ── Phase 1: batch loop ──────────────────────────────────────────────────

    function runBatch(offset, total) {
        var catalogId   = catalogEl.value.trim();
        var pricebookId = pricebookEl.value.trim() || 'list-prices';
        var currency    = currencyEl.value.trim()  || 'USD';
        var inventoryId = inventoryEl.value.trim() || 'default-inventory';
        var pct = (total > 0) ? Math.round((offset / total) * 100) : 0;

        setPhase('build', 'active',
            offset + ' / ' + (total || '?') + ' processed... (' + files + ' file(s) uploaded)', pct);

        post(
            BATCH_URL,
            'offset='         + offset
            + '&catalogId='       + encodeURIComponent(catalogId)
            + '&pricebookId='     + encodeURIComponent(pricebookId)
            + '&currency='        + encodeURIComponent(currency)
            + '&inventoryListId=' + encodeURIComponent(inventoryId),
            function (data) {
                if (!data.ok) {
                    setPhase('build', 'error', data.error || 'Failed', pct);
                    finalize(false);
                    return;
                }
                built          += (data.built          || 0);
                failed         += (data.failed         || 0);
                pricesBuilt    += (data.pricesBuilt    || 0);
                inventoryBuilt += (data.inventoryBuilt || 0);
                files++;

                overallEl.textContent = files + ' file(s): '
                    + built + ' product(s), '
                    + pricesBuilt + ' price(s), '
                    + inventoryBuilt + ' inventory record(s)'
                    + (failed ? ' — ' + failed + ' failed' : '');

                if (!data.done) {
                    runBatch(data.nextOffset, data.total);
                } else {
                    var st = (failed > 0 && built === 0) ? 'error' : (failed > 0) ? 'warning' : 'done';
                    setPhase('build', st,
                        files + ' file(s) uploaded — '
                        + built + ' product(s), ' + pricesBuilt + ' price(s), ' + inventoryBuilt + ' inventory record(s)'
                        + (failed ? ' — ' + failed + ' skipped' : ''), 100);
                    finalize(true);
                }
            }
        );
    }

    function finalize(success) {
        running              = false;
        startBtn.disabled    = false;
        startBtn.textContent = success ? 'Phase 1 Done' : 'Build Failed';

        statusBox.style.display = 'block';
        statusBox.className     = success
            ? 'acc-callout acc-callout--success'
            : 'acc-callout acc-callout--warning';

        if (success) {
            statusBox.innerHTML = '<strong>Phase 1 complete.</strong> '
                + files + ' batch(es) uploaded to <code>/Impex/src/instance/ctp-product-migration/</code>. '
                + built + ' product(s), ' + pricesBuilt + ' price(s), ' + inventoryBuilt + ' inventory record(s). '
                + 'Use Phase 2 below to trigger the catalog import job.';
            var p2ctrl = document.getElementById('prod-phase2-controls');
            if (p2ctrl) p2ctrl.style.display = 'block';
            setPhase('import', 'active', 'Enter Job ID below and click Trigger to import.', null);
        } else {
            statusBox.textContent = 'XML build failed — check BM logs for details.';
        }
    }

    // ── Phase 2: job trigger ─────────────────────────────────────────────────

    function triggerJob() {
        var jobId      = document.getElementById('prod-job-id').value.trim();
        var triggerBtn = document.getElementById('prod-trigger-btn');
        var jobMsg     = document.getElementById('prod-job-status-msg');
        if (!jobId || !triggerBtn) return;

        triggerBtn.disabled    = true;
        triggerBtn.textContent = 'Triggering...';
        jobMsg.textContent     = '';
        jobMsg.style.color     = '#54698d';

        post(TRIGGER_URL, 'jobId=' + encodeURIComponent(jobId), function (data) {
            if (!data.ok) {
                triggerBtn.disabled    = false;
                triggerBtn.textContent = 'Retry';
                jobMsg.textContent     = 'Error: ' + (data.error || 'Could not trigger job');
                jobMsg.style.color     = '#c62828';
                setPhase('import', 'error', 'Job trigger failed: ' + (data.error || 'unknown'), null);
                return;
            }
            var execId = data.executionId || '';
            jobMsg.textContent = 'Job started (execution: ' + execId + ') — polling every 5 s...';
            setPhase('import', 'active', 'Job running (execution: ' + execId + ')', null);
            pollJobStatus(jobId, execId);
        });
    }

    function pollJobStatus(jobId, executionId) {
        var jobMsg = document.getElementById('prod-job-status-msg');
        post(
            STATUS_URL,
            'jobId=' + encodeURIComponent(jobId) + '&executionId=' + encodeURIComponent(executionId),
            function (data) {
                if (!data.ok) {
                    if (jobMsg) {
                        jobMsg.textContent = 'Status check failed: ' + (data.error || 'unknown');
                        jobMsg.style.color = '#c62828';
                    }
                    setTimeout(function () { pollJobStatus(jobId, executionId); }, 10000);
                    return;
                }
                var status  = data.status || 'unknown';
                var durText = data.duration ? ' (' + data.duration + ' s)' : '';
                if (jobMsg) jobMsg.textContent = 'Job status: ' + status + durText;

                if (status === 'finished') {
                    if (jobMsg) jobMsg.style.color = '#2e7d32';
                    setPhase('import', 'done', 'Import complete' + durText, null);
                    statusBox.innerHTML = '<strong>Migration complete!</strong> '
                        + files + ' XML file(s) imported via job <em>' + jobId + '</em>' + durText + '.';
                    statusBox.className = 'acc-callout acc-callout--success';
                } else if (status === 'failed' || status === 'aborted' || status === 'expired') {
                    if (jobMsg) jobMsg.style.color = '#c62828';
                    setPhase('import', 'error', 'Job ' + status + durText, null);
                    var tb = document.getElementById('prod-trigger-btn');
                    if (tb) { tb.disabled = false; tb.textContent = 'Retry Job'; }
                } else {
                    if (jobMsg) jobMsg.style.color = '#54698d';
                    setTimeout(function () { pollJobStatus(jobId, executionId); }, 5000);
                }
            }
        );
    }

    document.addEventListener('click', function (evt) {
        if (evt.target && evt.target.id === 'prod-trigger-btn') triggerJob();
    });

    // ── Start Migration ──────────────────────────────────────────────────────

    startBtn.addEventListener('click', function () {
        var catalogId = catalogEl.value.trim();
        if (!catalogId) {
            showCatalogError('Catalog ID is required.');
            return;
        }
        clearCatalogError();
        if (running) return;

        running = true;
        built = 0; failed = 0; files = 0; pricesBuilt = 0; inventoryBuilt = 0;

        startBtn.disabled    = true;
        startBtn.textContent = 'Building...';
        statusBox.style.display = 'none';
        overallEl.textContent   = '';
        phaseList.style.display = 'block';

        setPhase('build',  'pending', '', 0);
        setPhase('import', 'pending', null, 0);

        // Save config to session first, then run batches
        var pricebookId = pricebookEl.value.trim() || 'list-prices';
        var currency    = currencyEl.value.trim()  || 'USD';
        var inventoryId = inventoryEl.value.trim() || 'default-inventory';

        post(
            SAVE_CFG_URL,
            'catalogId='       + encodeURIComponent(catalogId)
            + '&pricebookId='  + encodeURIComponent(pricebookId)
            + '&currency='     + encodeURIComponent(currency)
            + '&inventoryListId=' + encodeURIComponent(inventoryId),
            function () { runBatch(0, 0); }
        );
    });

}());
</script>

</body>
</html>
