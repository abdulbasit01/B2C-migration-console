<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>${pdict.title}</title>
    <link rel="stylesheet" href="${pdict.cssUrl}"/>
    <style>
        .acc-tab {
            padding: 8px 20px;
            font-size: 14px;
            font-weight: 600;
            border: none;
            border-bottom: 3px solid transparent;
            background: none;
            cursor: pointer;
            color: #54698d;
        }
        .acc-tab--active {
            color: #0070d2;
            border-bottom-color: #0070d2;
        }
        .acc-info-box {
            background: #f4f6f9;
            border: 1px solid #dddbda;
            border-radius: 4px;
            padding: 16px 20px;
            font-size: 13px;
            line-height: 1.6;
            margin-bottom: 20px;
        }
        .acc-info-box strong { color: #16325c; }
        .acc-info-box code {
            background: #e0e5ee;
            padding: 1px 5px;
            border-radius: 3px;
            font-family: monospace;
            font-size: 12px;
        }
        .acc-field-error {
            display: none;
            color: #c62828;
            font-size: 12px;
            margin-top: 4px;
        }
    </style>
</head>
<body class="acc-page">
<div class="acc-shell">

    <isinclude template="accelerator/components/header"/>

    <div style="padding:10px 32px 0;">
        <a href="${pdict.dashboardUrl}" style="font-size:13px;color:#0070d2;text-decoration:none;">&larr; Back to Platform Selection</a>
    </div>

    <section class="acc-section">
        <header class="acc-section__head">
            <h2>Customer Data Migration &mdash; <span class="acc-highlight">Commercetools &rarr; SFCC</span></h2>
            <p style="font-size:14px;color:#54698d;margin-top:6px;max-width:640px;">
                Choose a migration mode below. <strong>Partial</strong> imports customers one-at-a-time via the Script API
                (suitable for small datasets / testing). <strong>Full</strong> uploads SFCC-format XML files via WebDAV for
                bulk import via a BM job (suitable for production / millions of customers).
            </p>
        </header>

        <!-- ── Config row ── -->
        <div style="margin:24px 0 16px;">
            <div style="display:flex;align-items:flex-start;flex-wrap:wrap;gap:10px;">
                <label for="acc-list-id" style="font-weight:600;font-size:14px;white-space:nowrap;padding-top:6px;">
                    SFCC Customer List ID <span style="color:#c62828;">*</span>
                </label>
                <div>
                    <input id="acc-list-id" type="text" class="acc-form__input"
                           placeholder="e.g. RefArch or SiteGenesis"
                           value="${pdict.customerListId}"
                           style="width:260px;"/>
                    <span id="acc-list-id-error" class="acc-field-error">Customer List ID is required.</span>
                </div>
                <button id="acc-check-btn" type="button" class="acc-btn acc-btn--ghost">Check Count</button>
                <span id="acc-count-badge" style="font-size:13px;color:#54698d;padding-top:6px;"></span>
            </div>
        </div>

        <!-- ── Mode tabs ── -->
        <div style="display:flex;gap:0;border-bottom:2px solid #dddbda;margin-bottom:24px;">
            <button id="tab-partial" class="acc-tab acc-tab--active" type="button">Partial Migration</button>
            <button id="tab-full"    class="acc-tab"                 type="button">Full Migration (XML/WebDAV)</button>
        </div>

        <!-- ══════════════════════════════════════════════════════════════
             PANEL: PARTIAL MIGRATION
        ══════════════════════════════════════════════════════════════ -->
        <div id="panel-partial">

            <p style="font-size:13px;color:#54698d;margin:0 0 16px;">
                Creates customers one at a time using the SFCC Script API. Duplicate emails are skipped.
                Customers receive a random temporary password and must use <em>Forgot Password</em>.
            </p>

            <!-- ID filter -->
            <div style="margin-bottom:20px;">
                <label for="acc-ctp-ids" style="font-weight:600;font-size:14px;display:block;margin-bottom:6px;">
                    CTP Customer IDs <span style="color:#c62828;">*</span>
                    <span style="font-weight:400;color:#54698d;font-size:13px;">(comma-separated)</span>
                </label>
                <textarea id="acc-ctp-ids" class="acc-form__input"
                          rows="3"
                          placeholder="e.g. a1b2c3d4-..., e5f6g7h8-..."
                          style="width:100%;max-width:680px;resize:vertical;font-family:monospace;font-size:12px;"></textarea>
                <span id="acc-ctp-ids-error" class="acc-field-error"></span>
            </div>

            <!-- Phase progress bars -->
            <ul class="acc-phases" id="acc-phase-list" style="display:none;margin-bottom:24px;">
                <li class="acc-phases__item acc-phases__item--pending" id="acc-phase-profiles">
                    <div class="acc-phases__head">
                        <span>Phase 1 &mdash; Customer Profiles</span>
                        <span class="acc-phases__status" id="acc-status-profiles">pending</span>
                    </div>
                    <p class="acc-phases__detail" id="acc-detail-profiles"></p>
                    <div class="acc-progress">
                        <div class="acc-progress__bar" id="acc-bar-profiles" style="width:0%"></div>
                    </div>
                </li>
                <li class="acc-phases__item acc-phases__item--pending" id="acc-phase-addresses">
                    <div class="acc-phases__head">
                        <span>Phase 2 &mdash; Addresses</span>
                        <span class="acc-phases__status" id="acc-status-addresses">pending</span>
                    </div>
                    <p class="acc-phases__detail" id="acc-detail-addresses"></p>
                    <div class="acc-progress">
                        <div class="acc-progress__bar" id="acc-bar-addresses" style="width:0%"></div>
                    </div>
                </li>
            </ul>

            <!-- Result callout -->
            <div id="acc-move-status" class="acc-callout acc-callout--info" style="display:none;margin-bottom:20px;"></div>

            <!-- Controls -->
            <div class="acc-move-actions">
                <button type="button" id="acc-start-btn" class="acc-btn acc-btn--primary">
                    &#9654; Start Partial Migration
                </button>
                <span id="acc-move-overall" style="margin-left:14px;font-size:13px;color:#54698d;"></span>
            </div>

        </div><!-- /panel-partial -->

        <!-- ══════════════════════════════════════════════════════════════
             PANEL: FULL MIGRATION
        ══════════════════════════════════════════════════════════════ -->
        <div id="panel-full" style="display:none;">

            <div class="acc-info-box">
                <strong>How Full Migration works:</strong><br/>
                Phase 1 fetches customers from Commercetools in batches of 500, builds SFCC customer import XML,
                and uploads each file to WebDAV at
                <code>/Impex/src/instance/ctp-migration/</code>.<br/>
                Phase 2 is a manual BM step: run <strong>Administration &rarr; Site Development &rarr; Import &amp; Export
                &rarr; Import Customers</strong> and point it at the uploaded files.
                Customers receive a deterministic temporary password (<code>Rc1!</code> + first 12 chars of CTP ID);
                they must use <em>Forgot Password</em> to set their own.
            </div>

            <!-- Phase progress bars -->
            <ul class="acc-phases" id="full-phase-list" style="display:none;margin-bottom:24px;">
                <li class="acc-phases__item acc-phases__item--pending" id="full-phase-build">
                    <div class="acc-phases__head">
                        <span>Phase 1 &mdash; Build &amp; Upload XML Files</span>
                        <span class="acc-phases__status" id="full-status-build">pending</span>
                    </div>
                    <p class="acc-phases__detail" id="full-detail-build"></p>
                    <div class="acc-progress">
                        <div class="acc-progress__bar" id="full-bar-build" style="width:0%"></div>
                    </div>
                </li>
                <li class="acc-phases__item acc-phases__item--pending" id="full-phase-import">
                    <div class="acc-phases__head">
                        <span>Phase 2 &mdash; Import Customers Job</span>
                        <span class="acc-phases__status" id="full-status-import">pending</span>
                    </div>
                    <p class="acc-phases__detail" id="full-detail-import">Waiting for Phase 1&hellip;</p>
                    <!-- Job trigger UI — revealed after Phase 1 completes -->
                    <div id="full-phase2-controls" style="display:none;margin-top:14px;">
                        <p style="font-size:13px;color:#54698d;margin:0 0 10px;">
                            XML files are ready in <code>/Impex/src/instance/ctp-migration/</code>.
                            Enter the BM Job ID below and click <strong>Trigger</strong> to run the import automatically,
                            or run it manually via <strong>BM &rarr; Administration &rarr; Site Development &rarr;
                            Import &amp; Export &rarr; Import Customers</strong>.
                        </p>
                        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                            <label for="full-job-id" style="font-size:13px;font-weight:600;white-space:nowrap;">BM Job ID:</label>
                            <input id="full-job-id" type="text" class="acc-form__input"
                                   value="CTP-Customer-Import"
                                   style="width:220px;font-family:monospace;font-size:12px;"/>
                            <button type="button" id="full-trigger-btn" class="acc-btn acc-btn--secondary">
                                &#9658; Trigger Import Job
                            </button>
                        </div>
                        <div id="full-job-status-msg" style="margin-top:8px;font-size:13px;color:#54698d;"></div>
                    </div>
                </li>
            </ul>

            <!-- Result callout -->
            <div id="full-move-status" class="acc-callout acc-callout--info" style="display:none;margin-bottom:20px;"></div>

            <!-- Controls -->
            <div class="acc-move-actions">
                <button type="button" id="full-start-btn" class="acc-btn acc-btn--primary">
                    &#9654; Start Full Migration (Build XML)
                </button>
                <span id="full-move-overall" style="margin-left:14px;font-size:13px;color:#54698d;"></span>
            </div>

        </div><!-- /panel-full -->

    </section>
</div>

<script>
(function () {
    var COUNT_URL        = '${pdict.countUrl}';
    var PROFILE_URL      = '${pdict.profileUrl}';
    var ADDRESS_URL      = '${pdict.addressUrl}';
    var FULL_BATCH_URL   = '${pdict.fullBatchUrl}';
    var BY_ID_URL        = '${pdict.byIdUrl}';
    var TRIGGER_JOB_URL  = '${pdict.triggerJobUrl}';
    var JOB_STATUS_URL   = '${pdict.jobStatusUrl}';

    var listIdEl   = document.getElementById('acc-list-id');
    var checkBtn   = document.getElementById('acc-check-btn');
    var countBadge = document.getElementById('acc-count-badge');

    // ── Tab switching ────────────────────────────────────────────────────────

    var tabPartial  = document.getElementById('tab-partial');
    var tabFull     = document.getElementById('tab-full');
    var panelPartial = document.getElementById('panel-partial');
    var panelFull    = document.getElementById('panel-full');

    tabPartial.addEventListener('click', function () {
        tabPartial.className  = 'acc-tab acc-tab--active';
        tabFull.className     = 'acc-tab';
        panelPartial.style.display = '';
        panelFull.style.display    = 'none';
    });

    tabFull.addEventListener('click', function () {
        tabFull.className     = 'acc-tab acc-tab--active';
        tabPartial.className  = 'acc-tab';
        panelFull.style.display    = '';
        panelPartial.style.display = 'none';
    });

    // ── Inline field validation ──────────────────────────────────────────────

    function showError(inputId, errorId, msg) {
        var el  = document.getElementById(inputId);
        var err = document.getElementById(errorId);
        if (el)  el.style.borderColor = '#c62828';
        if (err) { err.textContent = msg; err.style.display = 'block'; }
    }

    function clearError(inputId, errorId) {
        var el  = document.getElementById(inputId);
        var err = document.getElementById(errorId);
        if (el)  el.style.borderColor = '';
        if (err) { err.textContent = ''; err.style.display = 'none'; }
    }

    // Clear errors as the user types
    listIdEl.addEventListener('input', function () { clearError('acc-list-id', 'acc-list-id-error'); });
    document.getElementById('acc-ctp-ids').addEventListener('input', function () { clearError('acc-ctp-ids', 'acc-ctp-ids-error'); });

    // ── Shared helpers ───────────────────────────────────────────────────────

    function setPhase(prefix, id, state, detail, pct) {
        var li  = document.getElementById(prefix + '-phase-' + id);
        var st  = document.getElementById(prefix + '-status-' + id);
        var det = document.getElementById(prefix + '-detail-' + id);
        var bar = document.getElementById(prefix + '-bar-' + id);
        if (!li) return;
        li.className  = 'acc-phases__item acc-phases__item--' + state;
        if (st)  st.textContent  = state;
        if (det && detail !== null) det.textContent = detail || '';
        if (bar) bar.style.width = (pct || 0) + '%';
    }

    function post(url, params, onDone) {
        var req = new XMLHttpRequest();
        req.open('POST', url, true);
        req.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        req.onreadystatechange = function () {
            if (req.readyState !== 4) return;
            var data;
            try { data = JSON.parse(req.responseText); } catch (e) { data = { ok: false, error: 'Parse error' }; }
            onDone(data);
        };
        req.send(params);
    }

    // ── Check count ──────────────────────────────────────────────────────────

    checkBtn.addEventListener('click', function () {
        countBadge.textContent = 'Checking…';
        post(COUNT_URL, '', function (data) {
            if (data.ok) {
                countBadge.textContent = data.total.toLocaleString() + ' customer(s) in CTP';
                countBadge.style.color = '#2e7d32';
            } else {
                countBadge.textContent = 'Error: ' + (data.error || 'Connection failed');
                countBadge.style.color = '#c62828';
            }
        });
    });

    // ════════════════════════════════════════════════════════════════════════
    // PARTIAL MIGRATION
    // ════════════════════════════════════════════════════════════════════════

    var startBtn    = document.getElementById('acc-start-btn');
    var overallEl   = document.getElementById('acc-move-overall');
    var statusBox   = document.getElementById('acc-move-status');
    var phaseList   = document.getElementById('acc-phase-list');

    var profilesCreated = 0;
    var profilesSkipped = 0;
    var profilesFailed  = 0;
    var profileErrors   = [];
    var addrsCreated    = 0;
    var addrsFailed     = 0;
    var allMappings     = [];
    var partialRunning  = false;

    function runProfiles(offset, total) {
        var listId = listIdEl.value.trim();
        var pct    = (total > 0) ? Math.round((offset / total) * 100) : 0;
        setPhase('acc', 'profiles', 'active', offset + ' / ' + (total || '?') + ' processed…', pct);

        post(
            PROFILE_URL,
            'offset=' + offset + '&listId=' + encodeURIComponent(listId),
            function (data) {
                if (!data.ok) {
                    setPhase('acc', 'profiles', 'error', data.error || 'Failed', 0);
                    startAddresses();
                    return;
                }

                profilesCreated += (data.created || 0);
                profilesSkipped += (data.skipped || 0);
                profilesFailed  += (data.failed  || 0);

                if (data.errors && data.errors.length) {
                    for (var e = 0; e < data.errors.length && profileErrors.length < 3; e++) {
                        profileErrors.push(data.errors[e]);
                    }
                }
                if (data.mappings && data.mappings.length) {
                    for (var m = 0; m < data.mappings.length; m++) {
                        allMappings.push(data.mappings[m]);
                    }
                }

                overallEl.textContent = 'Profiles: ' + profilesCreated + ' created, '
                    + profilesSkipped + ' skipped'
                    + (profilesFailed ? ', ' + profilesFailed + ' failed' : '');

                var newPct = (data.total > 0) ? Math.round((data.nextOffset / data.total) * 100) : 100;

                if (!data.done) {
                    setPhase('acc', 'profiles', 'active',
                        data.nextOffset + ' / ' + data.total + ' processed…', newPct);
                    runProfiles(data.nextOffset, data.total);
                } else {
                    var state1  = (profilesFailed > 0 && profilesCreated === 0) ? 'error'
                                : (profilesFailed > 0) ? 'warning' : 'done';
                    var detail1 = profilesCreated + ' created, ' + profilesSkipped + ' skipped'
                        + (profilesFailed ? ', ' + profilesFailed + ' failed' : '');
                    if (profileErrors.length) detail1 += ' — ' + profileErrors[0];
                    setPhase('acc', 'profiles', state1, detail1, 100);
                    startAddresses();
                }
            }
        );
    }

    function startAddresses() {
        if (!allMappings.length) {
            setPhase('acc', 'addresses', 'done', 'No addresses to migrate', 100);
            finalizePartial();
            return;
        }
        setPhase('acc', 'addresses', 'active', 'Starting…', 0);
        migrateCustomerAddresses(0, 0);
    }

    function migrateCustomerAddresses(mapIndex, addrOffset) {
        if (mapIndex >= allMappings.length) {
            var state2 = (addrsFailed > 0 && addrsCreated === 0) ? 'error'
                       : (addrsFailed > 0) ? 'warning' : 'done';
            setPhase('acc', 'addresses', state2,
                addrsCreated + ' address(es) created'
                + (addrsFailed ? ', ' + addrsFailed + ' failed' : ''),
                100);
            finalizePartial();
            return;
        }

        var mapping = allMappings[mapIndex];
        if (!mapping.sfccNo || !mapping.ctpAddresses || !mapping.ctpAddresses.length) {
            migrateCustomerAddresses(mapIndex + 1, 0);
            return;
        }

        var listId = listIdEl.value.trim();
        var pct    = Math.round((mapIndex / allMappings.length) * 100);
        setPhase('acc', 'addresses', 'active',
            'Customer ' + (mapIndex + 1) + ' / ' + allMappings.length
            + ' — ' + addrsCreated + ' address(es) done', pct);

        post(
            ADDRESS_URL,
            'customerNo=' + encodeURIComponent(mapping.sfccNo)
            + '&listId='   + encodeURIComponent(listId)
            + '&offset='   + addrOffset
            + '&addresses='+ encodeURIComponent(JSON.stringify(mapping.ctpAddresses)),
            function (data) {
                if (data.ok) {
                    addrsCreated += (data.created || 0);
                    addrsFailed  += (data.failed  || 0);
                    if (!data.done) {
                        migrateCustomerAddresses(mapIndex, data.nextOffset);
                    } else {
                        migrateCustomerAddresses(mapIndex + 1, 0);
                    }
                } else {
                    migrateCustomerAddresses(mapIndex + 1, 0);
                }
            }
        );
    }

    function finalizePartial() {
        partialRunning       = false;
        startBtn.disabled    = false;
        startBtn.textContent = '✔ Migration Complete';

        var hasErrors = (profilesFailed + addrsFailed) > 0;
        statusBox.style.display = 'block';
        statusBox.className     = hasErrors
            ? 'acc-callout acc-callout--warning'
            : 'acc-callout acc-callout--success';
        statusBox.textContent   = 'Done — '
            + profilesCreated + ' customer profile(s) imported, '
            + addrsCreated + ' address(es) created.'
            + (profilesSkipped > 0 ? ' ' + profilesSkipped + ' duplicate email(s) skipped.' : '')
            + (hasErrors ? ' Some records failed — check BM logs for details.' : '');
    }

    // ── Phase 1 (ID mode) – one request per CTP customer ID ──────────────────

    function runProfilesById(ids, index) {
        if (index >= ids.length) {
            var state1  = (profilesFailed > 0 && profilesCreated === 0) ? 'error'
                        : (profilesFailed > 0) ? 'warning' : 'done';
            var detail1 = profilesCreated + ' created, ' + profilesSkipped + ' skipped'
                + (profilesFailed ? ', ' + profilesFailed + ' failed' : '');
            if (profileErrors.length) detail1 += ' — ' + profileErrors[0];
            setPhase('acc', 'profiles', state1, detail1, 100);
            startAddresses();
            return;
        }

        var ctpId  = ids[index];
        var listId = listIdEl.value.trim();
        var pct    = Math.round((index / ids.length) * 100);
        setPhase('acc', 'profiles', 'active',
            (index + 1) + ' / ' + ids.length + ' — ' + ctpId, pct);

        post(BY_ID_URL,
            'ctpId=' + encodeURIComponent(ctpId) + '&listId=' + encodeURIComponent(listId),
            function (data) {
                if (!data.ok) {
                    profilesFailed++;
                    if (profileErrors.length < 3) profileErrors.push(ctpId + ': ' + (data.error || 'failed'));
                } else {
                    profilesCreated += (data.created || 0);
                    profilesSkipped += (data.skipped || 0);
                    profilesFailed  += (data.failed  || 0);
                    if (data.errors && data.errors.length) {
                        for (var e = 0; e < data.errors.length && profileErrors.length < 3; e++) {
                            profileErrors.push(data.errors[e]);
                        }
                    }
                    if (data.mappings && data.mappings.length) {
                        for (var m = 0; m < data.mappings.length; m++) {
                            allMappings.push(data.mappings[m]);
                        }
                    }
                }
                overallEl.textContent = 'Profiles: ' + profilesCreated + ' created, '
                    + profilesSkipped + ' skipped'
                    + (profilesFailed ? ', ' + profilesFailed + ' failed' : '');
                runProfilesById(ids, index + 1);
            }
        );
    }

    startBtn.addEventListener('click', function () {
        var listId = listIdEl.value.trim();
        var valid  = true;

        if (!listId) {
            showError('acc-list-id', 'acc-list-id-error', 'Customer List ID is required.');
            valid = false;
        } else {
            clearError('acc-list-id', 'acc-list-id-error');
        }

        var rawIds = document.getElementById('acc-ctp-ids').value.trim();
        var ids    = [];
        if (!rawIds) {
            showError('acc-ctp-ids', 'acc-ctp-ids-error', 'CTP Customer IDs are required.');
            valid = false;
        } else {
            ids = rawIds.split(',').map(function (s) { return s.trim(); }).filter(function (s) { return s.length > 0; });
            if (!ids.length) {
                showError('acc-ctp-ids', 'acc-ctp-ids-error', 'Enter at least one valid CTP Customer ID.');
                valid = false;
            } else {
                clearError('acc-ctp-ids', 'acc-ctp-ids-error');
            }
        }

        if (!valid || partialRunning) return;

        partialRunning   = true;
        profilesCreated  = 0; profilesSkipped = 0; profilesFailed = 0; profileErrors = [];
        addrsCreated     = 0; addrsFailed     = 0; allMappings    = [];

        startBtn.disabled    = true;
        startBtn.textContent = 'Running…';
        statusBox.style.display = 'none';
        overallEl.textContent   = '';
        phaseList.style.display = 'block';

        setPhase('acc', 'profiles',  'pending', '', 0);
        setPhase('acc', 'addresses', 'pending', '', 0);

        runProfilesById(ids, 0);
    });

    // ════════════════════════════════════════════════════════════════════════
    // FULL MIGRATION
    // ════════════════════════════════════════════════════════════════════════

    var fullStartBtn   = document.getElementById('full-start-btn');
    var fullOverallEl  = document.getElementById('full-move-overall');
    var fullStatusBox  = document.getElementById('full-move-status');
    var fullPhaseList  = document.getElementById('full-phase-list');

    var fullBuilt      = 0;
    var fullFailed     = 0;
    var fullFiles      = 0;
    var fullRunning    = false;

    function runFullBatch(offset, total) {
        var listId = listIdEl.value.trim();
        var pct    = (total > 0) ? Math.round((offset / total) * 100) : 0;
        setPhase('full', 'build', 'active',
            offset + ' / ' + (total || '?') + ' processed… (' + fullFiles + ' file(s) uploaded)', pct);

        post(
            FULL_BATCH_URL,
            'offset=' + offset + '&listId=' + encodeURIComponent(listId),
            function (data) {
                if (!data.ok) {
                    setPhase('full', 'build', 'error', data.error || 'Failed', pct);
                    finalizeFull(false);
                    return;
                }

                fullBuilt  += (data.built  || 0);
                fullFailed += (data.failed || 0);
                fullFiles++;

                var newPct = (data.total > 0) ? Math.round((data.nextOffset / data.total) * 100) : 100;
                fullOverallEl.textContent = fullFiles + ' file(s) uploaded, '
                    + fullBuilt + ' customer(s) built'
                    + (fullFailed ? ', ' + fullFailed + ' failed' : '');

                if (!data.done) {
                    runFullBatch(data.nextOffset, data.total);
                } else {
                    var buildState = (fullFailed > 0 && fullBuilt === 0) ? 'error'
                                   : (fullFailed > 0) ? 'warning' : 'done';
                    setPhase('full', 'build', buildState,
                        fullFiles + ' file(s) uploaded, ' + fullBuilt + ' customer(s) built'
                        + (fullFailed ? ', ' + fullFailed + ' skipped due to errors' : ''),
                        100);
                    setPhase('full', 'import', 'active',
                        'Files ready at /Impex/src/instance/ctp-migration/ — run Import Customers job in BM to finish.',
                        null);
                    finalizeFull(true);
                }
            }
        );
    }

    function finalizeFull(success) {
        fullRunning              = false;
        fullStartBtn.disabled    = false;
        fullStartBtn.textContent = success ? 'Phase 1 Done' : 'Build Failed';

        fullStatusBox.style.display = 'block';
        fullStatusBox.className     = success
            ? 'acc-callout acc-callout--success'
            : 'acc-callout acc-callout--warning';

        if (success) {
            fullStatusBox.innerHTML = '<strong>Phase 1 complete.</strong> '
                + fullFiles + ' XML file(s) uploaded to <code>/Impex/src/instance/ctp-migration/</code>. '
                + 'Use Phase 2 below to run the import job.';
            // Reveal job trigger controls inside the Phase 2 progress item
            var p2ctrl = document.getElementById('full-phase2-controls');
            if (p2ctrl) { p2ctrl.style.display = 'block'; }
            setPhase('full', 'import', 'active', 'Enter Job ID below and click Trigger to import.', null);
        } else {
            fullStatusBox.textContent = 'XML build failed — check BM logs for details.';
        }
    }

    // ── Phase 2: job trigger and status polling ───────────────────────────────

    function triggerJob() {
        var jobId      = document.getElementById('full-job-id').value.trim();
        var triggerBtn = document.getElementById('full-trigger-btn');
        var jobMsg     = document.getElementById('full-job-status-msg');
        if (!jobId || !triggerBtn) return;

        triggerBtn.disabled    = true;
        triggerBtn.textContent = 'Triggering...';
        jobMsg.textContent     = '';
        jobMsg.style.color     = '#54698d';

        post(TRIGGER_JOB_URL, 'jobId=' + encodeURIComponent(jobId), function (data) {
            if (!data.ok) {
                triggerBtn.disabled    = false;
                triggerBtn.textContent = 'Retry';
                jobMsg.textContent     = 'Error: ' + (data.error || 'Could not trigger job');
                jobMsg.style.color     = '#c62828';
                setPhase('full', 'import', 'error', 'Job trigger failed: ' + (data.error || 'unknown'), null);
                return;
            }
            var execId = data.executionId || '';
            jobMsg.textContent = 'Job started (execution: ' + execId + ') — polling every 5 s...';
            setPhase('full', 'import', 'active', 'Job running (execution: ' + execId + ')', null);
            pollJobStatus(jobId, execId);
        });
    }

    function pollJobStatus(jobId, executionId) {
        var jobMsg = document.getElementById('full-job-status-msg');
        post(
            JOB_STATUS_URL,
            'jobId=' + encodeURIComponent(jobId) + '&executionId=' + encodeURIComponent(executionId),
            function (data) {
                if (!data.ok) {
                    if (jobMsg) {
                        jobMsg.textContent = 'Status check failed: ' + (data.error || 'unknown');
                        jobMsg.style.color = '#c62828';
                    }
                    // Retry anyway after 10 s — transient errors are common in long-running jobs
                    setTimeout(function () { pollJobStatus(jobId, executionId); }, 10000);
                    return;
                }

                var status   = data.status || 'unknown';
                var durText  = data.duration ? ' (' + data.duration + ' s)' : '';
                var msgText  = 'Job status: ' + status + durText;
                if (jobMsg) { jobMsg.textContent = msgText; }

                if (status === 'finished') {
                    if (jobMsg) { jobMsg.style.color = '#2e7d32'; }
                    setPhase('full', 'import', 'done', 'Import complete' + durText, null);
                    fullStatusBox.innerHTML = '<strong>Migration complete!</strong> '
                        + fullFiles + ' XML file(s) imported via job <em>' + jobId + '</em>' + durText + '.';
                    fullStatusBox.className = 'acc-callout acc-callout--success';
                } else if (status === 'failed' || status === 'aborted' || status === 'expired') {
                    if (jobMsg) { jobMsg.style.color = '#c62828'; }
                    setPhase('full', 'import', 'error', 'Job ' + status + durText, null);
                    var trigBtn = document.getElementById('full-trigger-btn');
                    if (trigBtn) { trigBtn.disabled = false; trigBtn.textContent = 'Retry Job'; }
                } else {
                    // pending / running / paused — keep polling
                    if (jobMsg) { jobMsg.style.color = '#54698d'; }
                    setTimeout(function () { pollJobStatus(jobId, executionId); }, 5000);
                }
            }
        );
    }

    // Wire up trigger button (created in markup above, not yet in DOM when script loads — use delegation)
    document.addEventListener('click', function (evt) {
        if (evt.target && evt.target.id === 'full-trigger-btn') {
            triggerJob();
        }
    });

    fullStartBtn.addEventListener('click', function () {
        var listId = listIdEl.value.trim();
        if (!listId) {
            showError('acc-list-id', 'acc-list-id-error', 'Customer List ID is required.');
            return;
        }
        clearError('acc-list-id', 'acc-list-id-error');
        if (fullRunning) return;

        fullRunning   = true;
        fullBuilt     = 0; fullFailed = 0; fullFiles = 0;

        fullStartBtn.disabled    = true;
        fullStartBtn.textContent = 'Building…';
        fullStatusBox.style.display = 'none';
        fullOverallEl.textContent   = '';
        fullPhaseList.style.display = 'block';

        setPhase('full', 'build',   'pending', '', 0);
        setPhase('full', 'import',  'pending', null, 0);

        runFullBatch(0, 0);
    });

}());
</script>

</body>
</html>
