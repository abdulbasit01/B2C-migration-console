<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>${pdict.title}</title>
    <link rel="stylesheet" href="${pdict.cssUrl}"/>
    <style>
        .acc-tab {
            padding: 8px 20px;
            font-size: 14px;
            font-weight: 600;
            border: none;
            border-bottom: 3px solid transparent;
            background: none;
            cursor: pointer;
            color: #54698d;
        }
        .acc-tab--active {
            color: #0070d2;
            border-bottom-color: #0070d2;
        }
        .acc-info-box {
            background: #f4f6f9;
            border: 1px solid #dddbda;
            border-radius: 4px;
            padding: 16px 20px;
            font-size: 13px;
            line-height: 1.6;
            margin-bottom: 20px;
        }
        .acc-info-box strong { color: #16325c; }
        .acc-info-box code {
            background: #e0e5ee;
            padding: 1px 5px;
            border-radius: 3px;
            font-family: monospace;
            font-size: 12px;
        }
        .acc-field-error {
            display: none;
            color: #c62828;
            font-size: 12px;
            margin-top: 4px;
        }
        /* ---- Attribute pre-flight table ---- */
        .cm-attr-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }
        .cm-attr-table thead tr {
            background: #f4f6f9;
            border-bottom: 2px solid #dddbda;
        }
        .cm-attr-table th {
            padding: 9px 14px;
            text-align: left;
            font-size: 11px;
            font-weight: 700;
            color: #54698d;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }
        .cm-attr-table td {
            padding: 9px 14px;
            border-bottom: 1px solid #f0f2f8;
            color: #3e3e3c;
            vertical-align: middle;
        }
        .cm-attr-table tbody tr:last-child td { border-bottom: none; }
        .cm-attr-table tbody tr:hover { background: #f8f9fb; }
        .cm-attr-table td code {
            background: #eaf0fb;
            padding: 2px 7px;
            border-radius: 3px;
            font-family: monospace;
            font-size: 12px;
            color: #16325c;
            font-weight: 600;
        }
        .cm-attr-id-input {
            background: #eaf0fb;
            border: 1px solid #c8d6f0;
            border-radius: 3px;
            font-family: monospace;
            font-size: 12px;
            color: #16325c;
            font-weight: 600;
            padding: 3px 8px;
            width: 190px;
            outline: none;
            box-sizing: border-box;
        }
        .cm-attr-id-input:focus {
            border-color: #0070d2;
            background: #fff;
            box-shadow: 0 0 0 2px rgba(0,112,210,.15);
        }
        /* ---- Buttons used in dynamically-rendered attr results ---- */
        .cm-btn {
            padding: 7px 16px;
            font-size: 13px;
            font-weight: 600;
            border-radius: 4px;
            cursor: pointer;
            border: 1px solid transparent;
            display: inline-block;
            line-height: 1.4;
            white-space: nowrap;
        }
        .cm-btn--primary {
            background: #0070d2;
            color: #fff;
            border-color: #005fb2;
        }
        .cm-btn--primary:hover { background: #005fb2; }
        .cm-btn--primary:disabled {
            background: #97c3ea;
            border-color: #97c3ea;
            cursor: default;
        }
        .cm-btn--revert {
            background: #fff;
            color: #c62828;
            border: 1px solid #f0b4b4;
            padding: 4px 12px;
            font-size: 12px;
            font-weight: 600;
            border-radius: 4px;
            cursor: pointer;
            white-space: nowrap;
        }
        .cm-btn--revert:hover { background: #fdecea; border-color: #c62828; }
        .cm-btn--revert:disabled {
            opacity: 1;
            cursor: default;
            color: #c8c8c8;
            border-color: #e8e8e8;
            background: #fafafa;
            pointer-events: none;
        }
    </style>
</head>
<body class="acc-page">
<div class="acc-shell">

    <isinclude template="accelerator/components/header"/>

    <div style="padding:10px 32px 0;">
        <a href="${pdict.dashboardUrl}" style="font-size:13px;color:#0070d2;text-decoration:none;">&larr; Back to Platform Selection</a>
    </div>

    <section class="acc-section">
        <header class="acc-section__head">
            <h2>Customer Data Migration &mdash; <span class="acc-highlight">Commercetools &rarr; SFCC</span></h2>
            <p style="font-size:14px;color:#54698d;margin-top:6px;max-width:640px;">
                Choose a migration mode below. <strong>Partial</strong> imports customers one-at-a-time via the Script API
                (suitable for small datasets / testing). <strong>Full</strong> uploads SFCC-format XML files via WebDAV for
                bulk import via a BM job (suitable for production / millions of customers).
            </p>
        </header>

        <!-- -- Config row -- -->
        <div style="margin:24px 0 16px;">
            <div style="display:flex;align-items:flex-start;flex-wrap:wrap;gap:10px;">
                <label for="acc-list-id" style="font-weight:600;font-size:14px;white-space:nowrap;padding-top:6px;">
                    SFCC Customer List ID <span style="color:#c62828;">*</span>
                </label>
                <div>
                    <select id="acc-list-id" class="acc-form__input" style="width:260px;">
                        <option value="">Loading customer lists...</option>
                    </select>
                    <span id="acc-list-id-error" class="acc-field-error">Customer List ID is required.</span>
                </div>
                <button id="acc-check-btn" type="button" class="acc-btn acc-btn--ghost">Check Count</button>
                <span id="acc-count-badge" style="font-size:13px;color:#54698d;padding-top:6px;"></span>
            </div>
        </div>

        <!-- -- Customer Groups -- -->
        <div id="acc-cg-section" style="margin:0 0 28px;border:1px solid #dddbda;border-radius:6px;overflow:hidden;">
            <div style="background:#f4f6f9;border-bottom:1px solid #dddbda;padding:11px 20px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                <span style="font-weight:700;font-size:14px;color:#16325c;">&#x1F465; Customer Groups</span>
                <button id="acc-fetch-groups-btn" type="button" class="acc-btn acc-btn--ghost">Fetch CTP Groups</button>
                <span id="acc-cg-msg" style="font-size:13px;color:#54698d;font-weight:600;"></span>
            </div>
            <div style="padding:14px 20px;">
                <p style="margin:0 0 10px;font-size:13px;color:#54698d;">Load available customer groups from Commercetools, select which ones to create in SFCC, then click <strong>Create Selected Groups</strong>. Group IDs are kept exactly as-is to preserve the data bridge.</p>
                <div id="acc-cg-results" style="display:none;margin-top:10px;"></div>
                <div id="acc-cg-actions" style="display:none;margin-top:12px;display:none;gap:10px;align-items:center;flex-wrap:wrap;">
                    <button id="acc-create-groups-btn" type="button" class="cm-btn cm-btn--primary">Create Selected Groups in SFCC</button>
                    <span id="acc-create-groups-msg" style="font-size:13px;color:#54698d;font-weight:600;"></span>
                </div>
            </div>
        </div>

        <!-- -- Attribute pre-flight -- -->
        <div id="acc-attr-preflight" style="margin:0 0 28px;border:1px solid #dddbda;border-radius:6px;overflow:hidden;">
            <div style="background:#f4f6f9;border-bottom:1px solid #dddbda;padding:11px 20px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                <span style="font-weight:700;font-size:14px;color:#16325c;">&#x26A1; Attribute Pre-flight Check</span>
                <button id="acc-check-attrs-btn" type="button" class="acc-btn acc-btn--ghost">Check CTP Attributes</button>
                <span id="acc-attr-check-msg" style="font-size:13px;color:#54698d;font-weight:600;"></span>
            </div>
            <div style="padding:14px 20px;">
                <p style="font-size:13px;color:#54698d;margin:0;">
                    Scans CTP customer custom-type field definitions and checks whether matching
                    attributes exist on the SFCC <strong>Customer</strong> system object.
                    Missing attributes can be created here before the migration runs.
                </p>
                <div id="acc-attr-results" style="display:none;margin-top:14px;"></div>
            </div>
        </div>

        <!-- -- Mode tabs -- -->
        <div style="display:flex;gap:0;border-bottom:2px solid #dddbda;margin-bottom:24px;">
            <button id="tab-partial" class="acc-tab acc-tab--active" type="button">Partial Migration</button>
            <button id="tab-full"    class="acc-tab"                 type="button">Full Migration (XML/WebDAV)</button>
        </div>

        <!-- --------------------------------------------------------------
             PANEL: PARTIAL MIGRATION
        -------------------------------------------------------------- -->
        <div id="panel-partial">

            <p style="font-size:13px;color:#54698d;margin:0 0 16px;">
                Creates customers one at a time using the SFCC Script API. Duplicate emails are skipped.
                Customers receive a random temporary password and must use <em>Forgot Password</em>.
            </p>

            <!-- ID filter -->
            <div style="margin-bottom:20px;">
                <label for="acc-ctp-ids" style="font-weight:600;font-size:14px;display:block;margin-bottom:6px;">
                    Commercetools Customer UUID(s) <span style="color:#c62828;">*</span>
                    <span style="font-weight:400;color:#54698d;font-size:13px;">(comma-separated)</span>
                </label>
                <textarea id="acc-ctp-ids" class="acc-form__input"
                          rows="3"
                          placeholder="e.g. a1b2c3d4-e5f6-7890-abcd-ef1234567890, ..."
                          style="width:100%;max-width:680px;resize:vertical;font-family:monospace;font-size:12px;"></textarea>
                <span id="acc-ctp-ids-error" class="acc-field-error"></span>
                <p style="font-size:12px;color:#54698d;margin:5px 0 0;">
                    Enter the UUID(s) from the Commercetools platform (format: <code style="background:#f0f0f0;padding:1px 4px;border-radius:3px;">xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx</code>).
                    This is <strong>not</strong> the SFCC customer number shown in Business Manager.
                </p>
            </div>

            <!-- Phase progress bars -->
            <ul class="acc-phases" id="acc-phase-list" style="display:none;margin-bottom:24px;">
                <li class="acc-phases__item acc-phases__item--pending" id="acc-phase-profiles">
                    <div class="acc-phases__head">
                        <span>Phase 1 &mdash; Customer Profiles</span>
                        <span class="acc-phases__status" id="acc-status-profiles">pending</span>
                    </div>
                    <p class="acc-phases__detail" id="acc-detail-profiles"></p>
                    <div class="acc-progress">
                        <div class="acc-progress__bar" id="acc-bar-profiles" style="width:0%"></div>
                    </div>
                </li>
                <li class="acc-phases__item acc-phases__item--pending" id="acc-phase-addresses">
                    <div class="acc-phases__head">
                        <span>Phase 2 &mdash; Addresses</span>
                        <span class="acc-phases__status" id="acc-status-addresses">pending</span>
                    </div>
                    <p class="acc-phases__detail" id="acc-detail-addresses"></p>
                    <div class="acc-progress">
                        <div class="acc-progress__bar" id="acc-bar-addresses" style="width:0%"></div>
                    </div>
                </li>
            </ul>

            <!-- Result callout -->
            <div id="acc-move-status" class="acc-callout acc-callout--info" style="display:none;margin-bottom:20px;"></div>

            <!-- Controls -->
            <div class="acc-move-actions">
                <button type="button" id="acc-start-btn" class="acc-btn acc-btn--primary">
                    &#9654; Start Partial Migration
                </button>
                <span id="acc-move-overall" style="margin-left:14px;font-size:13px;color:#54698d;"></span>
            </div>

        </div><!-- /panel-partial -->

        <!-- --------------------------------------------------------------
             PANEL: FULL MIGRATION
        -------------------------------------------------------------- -->
        <div id="panel-full" style="display:none;">

            <div class="acc-info-box">
                <strong>How Full Migration works:</strong><br/>
                Phase 1 fetches customers from Commercetools in batches of 500, builds SFCC customer import XML,
                and uploads each file to WebDAV at
                <code>/Impex/src/instance/ctp-migration/</code>.<br/>
                Phase 2 is a manual BM step: run <strong>Administration &rarr; Site Development &rarr; Import &amp; Export
                &rarr; Import Customers</strong> and point it at the uploaded files.
                Customers receive a deterministic temporary password (<code>Rc1!</code> + first 12 chars of CTP ID);
                they must use <em>Forgot Password</em> to set their own.
            </div>

            <!-- Phase progress bars -->
            <ul class="acc-phases" id="full-phase-list" style="display:none;margin-bottom:24px;">
                <li class="acc-phases__item acc-phases__item--pending" id="full-phase-build">
                    <div class="acc-phases__head">
                        <span>Phase 1 &mdash; Build &amp; Upload XML Files</span>
                        <span class="acc-phases__status" id="full-status-build">pending</span>
                    </div>
                    <p class="acc-phases__detail" id="full-detail-build"></p>
                    <div class="acc-progress">
                        <div class="acc-progress__bar" id="full-bar-build" style="width:0%"></div>
                    </div>
                </li>
                <li class="acc-phases__item acc-phases__item--pending" id="full-phase-import">
                    <div class="acc-phases__head">
                        <span>Phase 2 &mdash; Run Import Job in Business Manager</span>
                        <span class="acc-phases__status" id="full-status-import">pending</span>
                    </div>
                    <p class="acc-phases__detail" id="full-detail-import">Waiting for Phase 1&hellip;</p>
                    <div style="margin-top:10px;">
                        <a href="${pdict.jobsUrl}"
                           target="_blank"
                           class="acc-btn acc-btn--primary"
                           style="text-decoration:none;font-size:13px;display:inline-block;padding:7px 16px;">
                            &#x2192; Open BM Jobs
                        </a>
                    </div>
                </li>
            </ul>

            <!-- Result callout -->
            <div id="full-move-status" class="acc-callout acc-callout--info" style="display:none;margin-bottom:20px;"></div>

            <!-- Controls -->
            <div class="acc-move-actions">
                <button type="button" id="full-start-btn" class="acc-btn acc-btn--primary">
                    &#9654; Start Full Migration (Build XML)
                </button>
                <span id="full-move-overall" style="margin-left:14px;font-size:13px;color:#54698d;"></span>
            </div>

        </div><!-- /panel-full -->

    </section>
</div>


<!-- Attribute pre-flight modal -->
<div id="acc-preflight-modal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.5);z-index:9999;align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:6px;padding:28px 32px;max-width:620px;width:90%;max-height:82vh;overflow-y:auto;box-shadow:0 8px 40px rgba(0,0,0,.3);">
        <h3 style="margin:0 0 6px;color:#16325c;font-size:16px;">Missing CTP Attributes in SFCC</h3>
        <p style="font-size:13px;color:#54698d;margin:0 0 16px;">
            The following CTP customer attributes do not exist on the SFCC <strong>Profile</strong> system object.
            Create them now so their values are stored during migration, or skip to migrate without them.
        </p>
        <div id="acc-modal-attr-list"></div>
        <p id="acc-modal-status" style="font-size:12px;margin:12px 0 0;min-height:16px;"></p>
        <div style="margin-top:16px;display:flex;gap:12px;justify-content:flex-end;flex-wrap:wrap;">
            <button id="acc-modal-skip"   type="button" class="acc-btn acc-btn--ghost">Skip &amp; Migrate</button>
            <button id="acc-modal-create" type="button" class="acc-btn acc-btn--primary">Create Attributes &amp; Migrate</button>
        </div>
    </div>
</div>

<script>
(function () {
    var COUNT_URL        = '${pdict.countUrl}';
    var PROFILE_URL      = '${pdict.profileUrl}';
    var ADDRESS_URL      = '${pdict.addressUrl}';
    var FULL_BATCH_URL   = '${pdict.fullBatchUrl}';
    var BY_ID_URL        = '${pdict.byIdUrl}';
    var LISTS_URL        = '${pdict.customerListsUrl}';
    var PRESET_LIST_ID   = '${pdict.customerListId}';
    var CHECK_ATTRS_URL   = '${pdict.checkAttrsUrl}';
    var CREATE_ATTRS_URL  = '${pdict.createAttrsUrl}';
    var DELETE_ATTR_URL   = '${pdict.deleteAttrUrl}';
    var FETCH_GROUPS_URL  = '${pdict.fetchGroupsUrl}';
    var CREATE_GROUPS_URL = '${pdict.createGroupsUrl}';

    var listIdEl   = document.getElementById('acc-list-id');
    var checkBtn   = document.getElementById('acc-check-btn');
    var countBadge = document.getElementById('acc-count-badge');

    // -- Tab switching --------------------------------------------------------

    var tabPartial  = document.getElementById('tab-partial');
    var tabFull     = document.getElementById('tab-full');
    var panelPartial = document.getElementById('panel-partial');
    var panelFull    = document.getElementById('panel-full');

    tabPartial.addEventListener('click', function () {
        tabPartial.className  = 'acc-tab acc-tab--active';
        tabFull.className     = 'acc-tab';
        panelPartial.style.display = '';
        panelFull.style.display    = 'none';
    });

    tabFull.addEventListener('click', function () {
        tabFull.className     = 'acc-tab acc-tab--active';
        tabPartial.className  = 'acc-tab';
        panelFull.style.display    = '';
        panelPartial.style.display = 'none';
    });

    // -- Inline field validation ----------------------------------------------

    function showError(inputId, errorId, msg) {
        var el  = document.getElementById(inputId);
        var err = document.getElementById(errorId);
        if (el)  el.style.borderColor = '#c62828';
        if (err) { err.textContent = msg; err.style.display = 'block'; }
    }

    function clearError(inputId, errorId) {
        var el  = document.getElementById(inputId);
        var err = document.getElementById(errorId);
        if (el)  el.style.borderColor = '';
        if (err) { err.textContent = ''; err.style.display = 'none'; }
    }

    // -- Load customer lists into dropdown on page init -----------------------

    (function loadCustomerLists() {
        var req = new XMLHttpRequest();
        req.open('GET', LISTS_URL, true);
        req.onreadystatechange = function () {
            if (req.readyState !== 4) return;
            var data;
            try { data = JSON.parse(req.responseText); } catch (e) { data = { ok: false }; }

            listIdEl.innerHTML = '';

            if (!data.ok || !data.lists || !data.lists.length) {
                var errOpt    = document.createElement('option');
                errOpt.value  = '';
                errOpt.textContent = data.ok
                    ? '? No customer lists found ?'
                    : '? Failed to load lists (' + (data.error || 'unknown') + ') ?';
                listIdEl.appendChild(errOpt);
                return;
            }

            var placeholder       = document.createElement('option');
            placeholder.value     = '';
            placeholder.textContent = ' Select a Customer List ?';
            listIdEl.appendChild(placeholder);

            for (var i = 0; i < data.lists.length; i++) {
                var opt         = document.createElement('option');
                opt.value       = data.lists[i].id;
                opt.textContent = data.lists[i].id;
                if (data.lists[i].id === PRESET_LIST_ID) { opt.selected = true; }
                listIdEl.appendChild(opt);
            }
        };
        req.send(null);
    }());

    // Clear errors when selection changes
    listIdEl.addEventListener('change', function () { clearError('acc-list-id', 'acc-list-id-error'); });

    // -- Customer Groups -------------------------------------------------------

    var fetchGroupsBtn    = document.getElementById('acc-fetch-groups-btn');
    var cgMsg             = document.getElementById('acc-cg-msg');
    var cgResults         = document.getElementById('acc-cg-results');
    var cgActions         = document.getElementById('acc-cg-actions');
    var createGroupsBtn   = document.getElementById('acc-create-groups-btn');
    var createGroupsMsg   = document.getElementById('acc-create-groups-msg');
    var availableGroups   = [];  // full list returned from CTP

    fetchGroupsBtn.addEventListener('click', function () {
        fetchGroupsBtn.disabled = true;
        cgMsg.textContent = 'Fetching...';
        cgMsg.style.color = '#54698d';
        var req = new XMLHttpRequest();
        req.open('GET', FETCH_GROUPS_URL, true);
        req.onreadystatechange = function () {
            if (req.readyState !== 4) return;
            fetchGroupsBtn.disabled = false;
            var data;
            try { data = JSON.parse(req.responseText); } catch (e) { data = { ok: false, error: 'Parse error' }; }
            if (!data.ok) {
                cgMsg.textContent = 'Error: ' + (data.error || 'Failed');
                cgMsg.style.color = '#c62828';
                return;
            }
            availableGroups = data.groups || [];
            cgMsg.textContent = availableGroups.length + ' group(s) found';
            cgMsg.style.color = '#2e7d32';
            renderGroupResults(availableGroups);
        };
        req.send();
    });

    function renderGroupResults(groups) {
        if (!groups.length) {
            cgResults.innerHTML = '<p style="font-size:13px;color:#54698d;">No customer groups found in Commercetools.</p>';
            cgResults.style.display = 'block';
            return;
        }
        var html = '<div style="border:1px solid #e0e5ee;border-radius:4px;overflow:hidden;">'
            + '<table style="width:100%;border-collapse:collapse;font-size:13px;">'
            + '<thead><tr style="background:#f4f6f9;">'
            + '<th style="padding:8px 12px;text-align:left;width:36px;"><input type="checkbox" id="acc-cg-select-all" checked/></th>'
            + '<th style="padding:8px 12px;text-align:left;font-weight:700;color:#16325c;">Group Name</th>'
            + '<th style="padding:8px 12px;text-align:left;font-weight:700;color:#16325c;">Group ID (CTP UUID)</th>'
            + '<th style="padding:8px 12px;text-align:left;font-weight:700;color:#16325c;">Key</th>'
            + '</tr></thead><tbody>';
        for (var i = 0; i < groups.length; i++) {
            var g = groups[i];
            html += '<tr style="border-top:1px solid #e0e5ee;">'
                + '<td style="padding:8px 12px;text-align:center;"><input type="checkbox" class="acc-cg-cb" data-idx="' + i + '" checked/></td>'
                + '<td style="padding:8px 12px;font-weight:600;color:#16325c;">' + escHtml(g.name) + '</td>'
                + '<td style="padding:8px 12px;font-family:monospace;font-size:12px;color:#0070d2;">' + escHtml(g.id) + '</td>'
                + '<td style="padding:8px 12px;color:#54698d;">' + escHtml(g.key || '-') + '</td>'
                + '</tr>';
        }
        html += '</tbody></table></div>';
        cgResults.innerHTML = html;
        cgResults.style.display = 'block';
        cgActions.style.display = 'flex';

        document.getElementById('acc-cg-select-all').addEventListener('change', function () {
            var cbs = document.querySelectorAll('.acc-cg-cb');
            for (var c = 0; c < cbs.length; c++) { cbs[c].checked = this.checked; }
        });
    }

    function escHtml(str) {
        return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    createGroupsBtn.addEventListener('click', function () {
        var selected = [];
        var cbs = document.querySelectorAll('.acc-cg-cb');
        for (var c = 0; c < cbs.length; c++) {
            if (cbs[c].checked) {
                var idx = parseInt(cbs[c].getAttribute('data-idx'), 10);
                selected.push(availableGroups[idx]);
            }
        }
        if (!selected.length) { createGroupsMsg.textContent = 'Select at least one group.'; createGroupsMsg.style.color = '#c62828'; return; }
        createGroupsBtn.disabled = true;
        createGroupsBtn.textContent = 'Creating...';
        createGroupsMsg.textContent = '';
        var req = new XMLHttpRequest();
        req.open('POST', CREATE_GROUPS_URL, true);
        req.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        req.onreadystatechange = function () {
            if (req.readyState !== 4) return;
            createGroupsBtn.disabled = false;
            createGroupsBtn.textContent = 'Create Selected Groups in SFCC';
            var data;
            try { data = JSON.parse(req.responseText); } catch (e) { data = { ok: false, error: 'Parse error' }; }
            if (!data.ok) {
                createGroupsMsg.textContent = 'Error: ' + (data.error || 'Failed');
                createGroupsMsg.style.color = '#c62828';
                return;
            }
            var r = data.result || {};
            var txt = r.created + ' created, ' + r.skipped + ' already existed';
            if (r.failed) txt += ', ' + r.failed + ' failed';
            if (r.errors && r.errors.length) txt += '. ' + r.errors[0];
            createGroupsMsg.textContent = txt;
            createGroupsMsg.style.color = r.failed ? '#c62828' : '#2e7d32';
            createGroupsBtn.textContent = 'Done';
        };
        req.send('groups=' + encodeURIComponent(JSON.stringify(selected)));
    });

    // -- Attribute pre-flight -------------------------------------------------

    var checkAttrsBtn  = document.getElementById('acc-check-attrs-btn');
    var attrCheckMsg   = document.getElementById('acc-attr-check-msg');
    var attrResults    = document.getElementById('acc-attr-results');
    var pendingMissing = [];

    function renderAttrResults(missing) {
        attrResults.innerHTML = '';
        attrResults.style.display = 'block';

        if (!missing.length) {
            attrResults.innerHTML = '<p style="color:#2e7d32;font-size:13px;margin:0;">'
                + '&#10003; All CTP customer attributes already exist in SFCC ? no action needed.</p>';
            return;
        }

        var html = '<p style="font-size:13px;color:#54698d;margin:0 0 10px;">'
            + missing.length + ' attribute(s) found in CTP but missing in SFCC. '
            + 'Select the ones you want to create:</p>';

        html += '<div style="border:1px solid #e0e5ee;border-radius:4px;overflow:hidden;">'
            + '<table class="cm-attr-table">'
            + '<thead><tr>'
            + '<th style="width:36px;"><input type="checkbox" id="acc-attr-select-all" checked/></th>'
            + '<th>Attribute ID</th>'
            + '<th>Label</th>'
            + '<th>CTP Type</th>'
            + '<th>SFCC Type</th>'
            + '<th style="width:90px;">Action</th>'
            + '</tr></thead><tbody>';

        for (var i = 0; i < missing.length; i++) {
            var m = missing[i];
            html += '<tr id="acc-attr-row-' + i + '">'
                + '<td style="text-align:center;"><input type="checkbox" class="acc-attr-cb" data-idx="' + i + '" checked/></td>'
                + '<td><input type="text" class="cm-attr-id-input" data-idx="' + i + '" value="' + m.id + '" title="Edit attribute ID"/></td>'
                + '<td>' + (m.label || m.id) + '</td>'
                + '<td style="color:#8a9ab8;">' + m.ctpType + '</td>'
                + '<td style="color:#0070d2;font-weight:600;">' + m.sfccType + '</td>'
                + '<td><button type="button" class="cm-btn--revert acc-attr-revert-btn" data-idx="' + i + '" disabled title="Create the attribute first to enable revert">Revert</button></td>'
                + '</tr>';
        }
        html += '</tbody></table></div>';

        html += '<div style="margin-top:14px;display:flex;align-items:center;gap:12px;">'
            + '<button type="button" id="acc-create-attrs-btn" class="cm-btn cm-btn--primary">&#10003; Create Selected Attributes</button>'
            + '<span id="acc-create-attrs-msg" style="font-size:13px;color:#54698d;"></span>'
            + '</div>';

        attrResults.innerHTML = html;

        // Select-all toggle
        document.getElementById('acc-attr-select-all').addEventListener('change', function () {
            var cbs = document.querySelectorAll('.acc-attr-cb');
            for (var c = 0; c < cbs.length; c++) { cbs[c].checked = this.checked; }
        });

        // Revert buttons — delete the attribute from SFCC Profile
        var revertBtns = document.querySelectorAll('.acc-attr-revert-btn');
        for (var rb = 0; rb < revertBtns.length; rb++) {
            revertBtns[rb].addEventListener('click', function () {
                var btn  = this;
                var idx  = parseInt(btn.getAttribute('data-idx'), 10);
                var idInput = document.querySelector('.cm-attr-id-input[data-idx="' + idx + '"]');
                var attrId  = idInput ? idInput.value.trim() : (pendingMissing[idx] || {}).id;
                if (!attrId) return;

                btn.disabled    = true;
                btn.textContent = 'Reverting...';

                var req = new XMLHttpRequest();
                req.open('POST', DELETE_ATTR_URL, true);
                req.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
                req.onreadystatechange = function () {
                    if (req.readyState !== 4) return;
                    var data;
                    try { data = JSON.parse(req.responseText); } catch (e) { data = { ok: false, error: 'Parse error' }; }

                    if (data.ok) {
                        btn.textContent      = 'Reverted';
                        btn.style.color      = '#2e7d32';
                        btn.style.borderColor = '#a5d6a7';
                        btn.style.background  = '#e8f5e9';
                        var row = document.getElementById('acc-attr-row-' + idx);
                        if (row) { row.style.opacity = '0.5'; }
                    } else {
                        btn.disabled    = false;
                        btn.textContent = 'Revert';
                        var msgEl = document.getElementById('acc-create-attrs-msg');
                        if (msgEl) {
                            msgEl.textContent = 'Revert failed (' + attrId + '): ' + (data.error || 'Unknown error');
                            msgEl.style.color = '#c62828';
                        }
                    }
                };
                req.send('attrId=' + encodeURIComponent(attrId));
            });
        }

        document.getElementById('acc-create-attrs-btn').addEventListener('click', function () {
            var selected         = [];
            var selectedIndices  = [];
            var cbs = document.querySelectorAll('.acc-attr-cb');
            for (var c = 0; c < cbs.length; c++) {
                if (cbs[c].checked) {
                    var idx     = parseInt(cbs[c].getAttribute('data-idx'), 10);
                    var orig    = pendingMissing[idx];
                    var idInput = document.querySelector('.cm-attr-id-input[data-idx="' + idx + '"]');
                    var editedId = (idInput && idInput.value.trim()) ? idInput.value.trim() : orig.id;
                    selected.push({ id: editedId, label: orig.label, ctpType: orig.ctpType, sfccType: orig.sfccType });
                    selectedIndices.push(idx);
                }
            }
            if (!selected.length) {
                document.getElementById('acc-create-attrs-msg').textContent = 'Select at least one attribute.';
                return;
            }
            createSelectedAttributes(selected, selectedIndices);
        });
    }

    function createSelectedAttributes(selected, selectedIndices) {
        var btn = document.getElementById('acc-create-attrs-btn');
        var msg = document.getElementById('acc-create-attrs-msg');
        if (btn) { btn.disabled = true; btn.textContent = 'Creating...'; }
        if (msg) { msg.textContent = ''; }

        var req = new XMLHttpRequest();
        req.open('POST', CREATE_ATTRS_URL, true);
        req.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        req.onreadystatechange = function () {
            if (req.readyState !== 4) return;
            var data;
            try { data = JSON.parse(req.responseText); } catch (e) { data = { ok: false, error: 'Parse error' }; }

            if (!data.ok) {
                if (btn) { btn.disabled = false; btn.textContent = 'Retry'; }
                if (msg) { msg.textContent = 'Error: ' + (data.error || 'Failed'); msg.style.color = '#c62828'; }
                return;
            }

            var r    = data.result || {};
            var text = r.created + ' created' + (r.failed ? ', ' + r.failed + ' failed' : '') + '.';
            if (r.errors && r.errors.length) text += ' ' + r.errors[0];

            if (btn) { btn.disabled = true; btn.textContent = '✓ Done'; }
            if (msg) {
                msg.textContent = text;
                msg.style.color = r.failed ? '#c62828' : '#2e7d32';
            }

            // Enable Revert buttons for every row that was just created
            var indices = selectedIndices || [];
            for (var ri = 0; ri < indices.length; ri++) {
                var revertBtn = document.querySelector('.acc-attr-revert-btn[data-idx="' + indices[ri] + '"]');
                if (revertBtn) {
                    revertBtn.disabled = false;
                    revertBtn.title    = '';
                }
            }
        };
        req.send('attrs=' + encodeURIComponent(JSON.stringify(selected)));
    }

    checkAttrsBtn.addEventListener('click', function () {
        checkAttrsBtn.disabled    = true;
        checkAttrsBtn.textContent = 'Checking...';
        attrCheckMsg.textContent  = '';
        attrResults.style.display = 'none';

        var req = new XMLHttpRequest();
        req.open('GET', CHECK_ATTRS_URL, true);
        req.onreadystatechange = function () {
            if (req.readyState !== 4) return;
            checkAttrsBtn.disabled    = false;
            checkAttrsBtn.textContent = 'Re-check';

            var data;
            try { data = JSON.parse(req.responseText); } catch (e) { data = { ok: false, error: 'Parse error' }; }

            if (!data.ok) {
                attrCheckMsg.textContent = 'Error: ' + (data.error || 'Check failed');
                attrCheckMsg.style.color = '#c62828';
                return;
            }

            pendingMissing           = data.missing || [];
            attrCheckMsg.textContent = pendingMissing.length
                ? pendingMissing.length + ' missing attribute(s) found.'
                : 'All attributes in sync.';
            attrCheckMsg.style.color = pendingMissing.length ? '#e65100' : '#2e7d32';
            renderAttrResults(pendingMissing);
        };
        req.send(null);
    });
    document.getElementById('acc-ctp-ids').addEventListener('input', function () { clearError('acc-ctp-ids', 'acc-ctp-ids-error'); });

    // -- Shared helpers -------------------------------------------------------

    function setPhase(prefix, id, state, detail, pct) {
        var li  = document.getElementById(prefix + '-phase-' + id);
        var st  = document.getElementById(prefix + '-status-' + id);
        var det = document.getElementById(prefix + '-detail-' + id);
        var bar = document.getElementById(prefix + '-bar-' + id);
        if (!li) return;
        li.className  = 'acc-phases__item acc-phases__item--' + state;
        if (st)  st.textContent  = state;
        if (det && detail !== null) det.textContent = detail || '';
        if (bar) bar.style.width = (pct || 0) + '%';
    }

    function post(url, params, onDone) {
        var req = new XMLHttpRequest();
        req.open('POST', url, true);
        req.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        req.onreadystatechange = function () {
            if (req.readyState !== 4) return;
            var data;
            try { data = JSON.parse(req.responseText); } catch (e) { data = { ok: false, error: 'Parse error' }; }
            onDone(data);
        };
        req.send(params);
    }

    // -- Check count ----------------------------------------------------------

    checkBtn.addEventListener('click', function () {
        countBadge.textContent = 'Checking...';
        post(COUNT_URL, '', function (data) {
            if (data.ok) {
                countBadge.textContent = data.total.toLocaleString() + ' customer(s) in CTP';
                countBadge.style.color = '#2e7d32';
            } else {
                countBadge.textContent = 'Error: ' + (data.error || 'Connection failed');
                countBadge.style.color = '#c62828';
            }
        });
    });

    // ????????????????????????????????????????????????????????????????????????
    // PARTIAL MIGRATION
    // ????????????????????????????????????????????????????????????????????????

    var startBtn    = document.getElementById('acc-start-btn');
    var overallEl   = document.getElementById('acc-move-overall');
    var statusBox   = document.getElementById('acc-move-status');
    var phaseList   = document.getElementById('acc-phase-list');

    var profilesCreated = 0;
    var profilesSkipped = 0;
    var profilesFailed  = 0;
    var profileErrors   = [];
    var addrsCreated    = 0;
    var addrsFailed     = 0;
    var allMappings     = [];
    var partialRunning  = false;

    function runProfiles(offset, total) {
        var listId = listIdEl.value.trim();
        var pct    = (total > 0) ? Math.round((offset / total) * 100) : 0;
        setPhase('acc', 'profiles', 'active', offset + ' / ' + (total || '?') + ' processed...', pct);

        post(
            PROFILE_URL,
            'offset=' + offset + '&listId=' + encodeURIComponent(listId),
            function (data) {
                if (!data.ok) {
                    setPhase('acc', 'profiles', 'error', data.error || 'Failed', 0);
                    startAddresses();
                    return;
                }

                profilesCreated += (data.created || 0);
                profilesSkipped += (data.skipped || 0);
                profilesFailed  += (data.failed  || 0);

                if (data.errors && data.errors.length) {
                    for (var e = 0; e < data.errors.length && profileErrors.length < 3; e++) {
                        profileErrors.push(data.errors[e]);
                    }
                }
                if (data.mappings && data.mappings.length) {
                    for (var m = 0; m < data.mappings.length; m++) {
                        allMappings.push(data.mappings[m]);
                    }
                }

                overallEl.textContent = 'Profiles: ' + profilesCreated + ' created, '
                    + profilesSkipped + ' skipped'
                    + (profilesFailed ? ', ' + profilesFailed + ' failed' : '');

                var newPct = (data.total > 0) ? Math.round((data.nextOffset / data.total) * 100) : 100;

                if (!data.done) {
                    setPhase('acc', 'profiles', 'active',
                        data.nextOffset + ' / ' + data.total + ' processed...', newPct);
                    runProfiles(data.nextOffset, data.total);
                } else {
                    var state1  = (profilesFailed > 0 && profilesCreated === 0) ? 'error'
                                : (profilesFailed > 0) ? 'warning' : 'done';
                    var detail1 = profilesCreated + ' created, ' + profilesSkipped + ' skipped'
                        + (profilesFailed ? ', ' + profilesFailed + ' failed' : '');
                    if (profileErrors.length) detail1 += ' ? ' + profileErrors[0];
                    setPhase('acc', 'profiles', state1, detail1, 100);
                    startAddresses();
                }
            }
        );
    }

    function startAddresses() {
        if (!allMappings.length) {
            setPhase('acc', 'addresses', 'done', 'No addresses to migrate', 100);
            finalizePartial();
            return;
        }
        setPhase('acc', 'addresses', 'active', 'Starting...', 0);
        migrateCustomerAddresses(0, 0);
    }

    function migrateCustomerAddresses(mapIndex, addrOffset) {
        if (mapIndex >= allMappings.length) {
            var state2 = (addrsFailed > 0 && addrsCreated === 0) ? 'error'
                       : (addrsFailed > 0) ? 'warning' : 'done';
            setPhase('acc', 'addresses', state2,
                addrsCreated + ' address(es) created'
                + (addrsFailed ? ', ' + addrsFailed + ' failed' : ''),
                100);
            finalizePartial();
            return;
        }

        var mapping = allMappings[mapIndex];
        if (!mapping.sfccNo || !mapping.ctpAddresses || !mapping.ctpAddresses.length) {
            migrateCustomerAddresses(mapIndex + 1, 0);
            return;
        }

        var listId = listIdEl.value.trim();
        var pct    = Math.round((mapIndex / allMappings.length) * 100);
        setPhase('acc', 'addresses', 'active',
            'Customer ' + (mapIndex + 1) + ' / ' + allMappings.length
            + ' ? ' + addrsCreated + ' address(es) done', pct);

        post(
            ADDRESS_URL,
            'customerNo=' + encodeURIComponent(mapping.sfccNo)
            + '&listId='   + encodeURIComponent(listId)
            + '&offset='   + addrOffset
            + '&addresses='+ encodeURIComponent(JSON.stringify(mapping.ctpAddresses)),
            function (data) {
                if (data.ok) {
                    addrsCreated += (data.created || 0);
                    addrsFailed  += (data.failed  || 0);
                    if (!data.done) {
                        migrateCustomerAddresses(mapIndex, data.nextOffset);
                    } else {
                        migrateCustomerAddresses(mapIndex + 1, 0);
                    }
                } else {
                    migrateCustomerAddresses(mapIndex + 1, 0);
                }
            }
        );
    }

    function finalizePartial() {
        partialRunning       = false;
        startBtn.disabled    = false;
        startBtn.textContent = '? Migration Complete';

        var hasErrors = (profilesFailed + addrsFailed) > 0;
        statusBox.style.display = 'block';
        statusBox.className     = hasErrors
            ? 'acc-callout acc-callout--warning'
            : 'acc-callout acc-callout--success';
        statusBox.textContent   = 'Done ? '
            + profilesCreated + ' customer profile(s) imported, '
            + addrsCreated + ' address(es) created.'
            + (profilesSkipped > 0 ? ' ' + profilesSkipped + ' duplicate email(s) skipped.' : '')
            + (hasErrors ? ' Some records failed ? check BM logs for details.' : '');
    }

    // -- Phase 1 (ID mode) ? one request per CTP customer ID ------------------

    function runProfilesById(ids, index) {
        if (index >= ids.length) {
            var state1  = (profilesFailed > 0 && profilesCreated === 0) ? 'error'
                        : (profilesFailed > 0) ? 'warning' : 'done';
            var detail1 = profilesCreated + ' created, ' + profilesSkipped + ' skipped'
                + (profilesFailed ? ', ' + profilesFailed + ' failed' : '');
            if (profileErrors.length) detail1 += ' ? ' + profileErrors[0];
            setPhase('acc', 'profiles', state1, detail1, 100);
            startAddresses();
            return;
        }

        var ctpId  = ids[index];
        var listId = listIdEl.value.trim();
        var pct    = Math.round((index / ids.length) * 100);
        setPhase('acc', 'profiles', 'active',
            (index + 1) + ' / ' + ids.length + ' ? ' + ctpId, pct);

        post(BY_ID_URL,
            'ctpId=' + encodeURIComponent(ctpId) + '&listId=' + encodeURIComponent(listId),
            function (data) {
                if (!data.ok) {
                    profilesFailed++;
                    if (profileErrors.length < 3) profileErrors.push(ctpId + ': ' + (data.error || 'failed'));
                } else {
                    profilesCreated += (data.created || 0);
                    profilesSkipped += (data.skipped || 0);
                    profilesFailed  += (data.failed  || 0);
                    if (data.errors && data.errors.length) {
                        for (var e = 0; e < data.errors.length && profileErrors.length < 3; e++) {
                            profileErrors.push(data.errors[e]);
                        }
                    }
                    if (data.mappings && data.mappings.length) {
                        for (var m = 0; m < data.mappings.length; m++) {
                            allMappings.push(data.mappings[m]);
                        }
                    }
                }
                overallEl.textContent = 'Profiles: ' + profilesCreated + ' created, '
                    + profilesSkipped + ' skipped'
                    + (profilesFailed ? ', ' + profilesFailed + ' failed' : '');
                runProfilesById(ids, index + 1);
            }
        );
    }

    // ????????????????????????????????????????????????????????????????????????
    // ATTRIBUTE PRE-FLIGHT MODAL
    // ????????????????????????????????????????????????????????????????????????

    var preflightModal = document.getElementById('acc-preflight-modal');
    var modalAttrList  = document.getElementById('acc-modal-attr-list');
    var modalSkipBtn   = document.getElementById('acc-modal-skip');
    var modalCreateBtn = document.getElementById('acc-modal-create');
    var modalStatus    = document.getElementById('acc-modal-status');
    var modalMissing   = [];
    var modalCallback  = null;

    function showPreflightModal(missing, onContinue) {
        modalMissing  = missing;
        modalCallback = onContinue;

        var html = '<div style="border:1px solid #e0e5ee;border-radius:4px;overflow:hidden;margin-bottom:4px;">'
            + '<table class="cm-attr-table">'
            + '<thead><tr>'
            + '<th>Attribute ID</th>'
            + '<th>Label</th>'
            + '<th>CTP Type</th>'
            + '<th>SFCC Type</th>'
            + '</tr></thead><tbody>';
        for (var i = 0; i < missing.length; i++) {
            var m = missing[i];
            html += '<tr>'
                + '<td><code>' + m.id + '</code></td>'
                + '<td>' + (m.label || m.id) + '</td>'
                + '<td style="color:#8a9ab8;">' + m.ctpType + '</td>'
                + '<td style="color:#0070d2;font-weight:600;">' + m.sfccType + '</td>'
                + '</tr>';
        }
        html += '</tbody></table></div>';
        modalAttrList.innerHTML    = html;
        modalStatus.textContent    = '';
        modalStatus.style.color    = '#54698d';
        modalCreateBtn.disabled    = false;
        modalCreateBtn.textContent = 'Create Attributes & Migrate';
        preflightModal.style.display = 'flex';
    }

    function closePreflightModal() {
        preflightModal.style.display = 'none';
    }

    modalSkipBtn.addEventListener('click', function () {
        closePreflightModal();
        if (modalCallback) { modalCallback(); }
    });

    modalCreateBtn.addEventListener('click', function () {
        modalCreateBtn.disabled    = true;
        modalCreateBtn.textContent = 'Creating attributes...';
        modalStatus.textContent    = '';

        var req = new XMLHttpRequest();
        req.open('POST', CREATE_ATTRS_URL, true);
        req.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        req.onreadystatechange = function () {
            if (req.readyState !== 4) return;
            var data;
            try { data = JSON.parse(req.responseText); } catch (e) { data = { ok: false, error: 'Parse error' }; }

            if (!data.ok) {
                modalStatus.textContent = 'Error: ' + (data.error || 'Attribute creation failed');
                modalStatus.style.color = '#c62828';
                modalCreateBtn.disabled    = false;
                modalCreateBtn.textContent = 'Retry';
                return;
            }

            var r    = data.result || {};
            var msg  = r.created + ' attribute(s) created';
            if (r.failed) msg += ', ' + r.failed + ' failed';
            modalStatus.textContent = msg + '. Starting migration...';
            modalStatus.style.color = r.failed ? '#e65100' : '#2e7d32';

            setTimeout(function () {
                closePreflightModal();
                if (modalCallback) { modalCallback(); }
            }, 900);
        };
        req.send('attrs=' + encodeURIComponent(JSON.stringify(modalMissing)));
    });

    /**
     * Run the attribute pre-flight check, then call onContinue.
     * - Missing attributes found ? show modal so user can create them first.
     * - All attributes present  ? call onContinue directly.
     * - Check fails             ? show the modal in error mode so the user knows,
     *                             but still allows them to proceed.
     */
    function runPreflightThenMigrate(onContinue) {
        var req = new XMLHttpRequest();
        req.open('GET', CHECK_ATTRS_URL, true);
        req.onreadystatechange = function () {
            if (req.readyState !== 4) return;
            var data;
            try { data = JSON.parse(req.responseText); } catch (e) { data = { ok: false, error: 'Response parse error' }; }

            if (!data.ok) {
                // Check failed ? show modal with error message so user can decide to proceed anyway
                showPreflightError(data.error || 'Attribute check failed', onContinue);
                return;
            }

            if (data.missing && data.missing.length > 0) {
                showPreflightModal(data.missing, onContinue);
            } else {
                onContinue();
            }
        };
        req.onerror = function () {
            showPreflightError('Network error ? could not reach the attribute check endpoint', onContinue);
        };
        req.send(null);
    }

    function showPreflightError(errorMsg, onContinue) {
        modalAttrList.innerHTML = '<p style="color:#c62828;font-size:13px;margin:0 0 8px;">'
            + '<strong>Could not check CTP attributes:</strong> ' + errorMsg + '</p>'
            + '<p style="font-size:13px;color:#54698d;margin:0;">You can proceed without the check ? '
            + 'missing attributes will not be created automatically.</p>';
        modalStatus.textContent = '';
        modalCreateBtn.style.display = 'none';
        modalSkipBtn.textContent = 'Proceed Anyway';
        modalCallback = function () {
            modalCreateBtn.style.display = '';
            modalSkipBtn.textContent = 'Skip & Migrate';
            onContinue();
        };
        preflightModal.style.display = 'flex';
    }

    // ????????????????????????????????????????????????????????????????????????
    // PARTIAL MIGRATION ? start button (with pre-flight)
    // ????????????????????????????????????????????????????????????????????????

    startBtn.addEventListener('click', function () {
        var listId = listIdEl.value.trim();
        var valid  = true;

        if (!listId) {
            showError('acc-list-id', 'acc-list-id-error', 'Customer List ID is required.');
            valid = false;
        } else {
            clearError('acc-list-id', 'acc-list-id-error');
        }

        var rawIds = document.getElementById('acc-ctp-ids').value.trim();
        var ids    = [];
        if (!rawIds) {
            showError('acc-ctp-ids', 'acc-ctp-ids-error', 'CTP Customer IDs are required.');
            valid = false;
        } else {
            ids = rawIds.split(',').map(function (s) { return s.trim(); }).filter(function (s) { return s.length > 0; });
            if (!ids.length) {
                showError('acc-ctp-ids', 'acc-ctp-ids-error', 'Enter at least one valid CTP Customer ID.');
                valid = false;
            } else {
                clearError('acc-ctp-ids', 'acc-ctp-ids-error');
            }
        }

        if (!valid || partialRunning) return;

        startBtn.disabled    = true;
        startBtn.textContent = 'Checking attributes...';

        runPreflightThenMigrate(function () {
            partialRunning   = true;
            profilesCreated  = 0; profilesSkipped = 0; profilesFailed = 0; profileErrors = [];
            addrsCreated     = 0; addrsFailed     = 0; allMappings    = [];

            startBtn.textContent    = 'Running...';
            statusBox.style.display = 'none';
            overallEl.textContent   = '';
            phaseList.style.display = 'block';

            setPhase('acc', 'profiles',  'pending', '', 0);
            setPhase('acc', 'addresses', 'pending', '', 0);

            runProfilesById(ids, 0);
        });
    });

    // ????????????????????????????????????????????????????????????????????????
    // FULL MIGRATION
    // ????????????????????????????????????????????????????????????????????????

    var fullStartBtn   = document.getElementById('full-start-btn');
    var fullOverallEl  = document.getElementById('full-move-overall');
    var fullStatusBox  = document.getElementById('full-move-status');
    var fullPhaseList  = document.getElementById('full-phase-list');

    var fullBuilt      = 0;
    var fullFailed     = 0;
    var fullFiles      = 0;
    var fullRunning    = false;

    function runFullBatch(offset, total) {
        var listId = listIdEl.value.trim();
        var pct    = (total > 0) ? Math.round((offset / total) * 100) : 0;
        setPhase('full', 'build', 'active',
            offset + ' / ' + (total || '?') + ' processed... (' + fullFiles + ' file(s) uploaded)', pct);

        post(
            FULL_BATCH_URL,
            'offset=' + offset + '&listId=' + encodeURIComponent(listId),
            function (data) {
                if (!data.ok) {
                    setPhase('full', 'build', 'error', data.error || 'Failed', pct);
                    finalizeFull(false);
                    return;
                }

                fullBuilt  += (data.built  || 0);
                fullFailed += (data.failed || 0);
                fullFiles++;

                var newPct = (data.total > 0) ? Math.round((data.nextOffset / data.total) * 100) : 100;
                fullOverallEl.textContent = fullFiles + ' file(s) uploaded, '
                    + fullBuilt + ' customer(s) built'
                    + (fullFailed ? ', ' + fullFailed + ' failed' : '');

                if (!data.done) {
                    runFullBatch(data.nextOffset, data.total);
                } else {
                    var buildState = (fullFailed > 0 && fullBuilt === 0) ? 'error'
                                   : (fullFailed > 0) ? 'warning' : 'done';
                    setPhase('full', 'build', buildState,
                        fullFiles + ' file(s) uploaded, ' + fullBuilt + ' customer(s) built'
                        + (fullFailed ? ', ' + fullFailed + ' skipped due to errors' : ''),
                        100);
                    finalizeFull(true);
                }
            }
        );
    }

    function finalizeFull(success) {
        fullRunning              = false;
        fullStartBtn.disabled    = false;
        fullStartBtn.textContent = success ? 'Phase 1 Done' : 'Build Failed';

        if (success) {
            fullStatusBox.style.display = 'none';
            setPhase('full', 'import', 'active',
                'Run your import job in Business Manager to complete the migration.', null);
        } else {
            fullStatusBox.style.display = 'block';
            fullStatusBox.className     = 'acc-callout acc-callout--warning';
            fullStatusBox.textContent   = 'XML build failed - check BM logs for details.';
        }
    }

    fullStartBtn.addEventListener('click', function () {
        var listId = listIdEl.value.trim();
        if (!listId) {
            showError('acc-list-id', 'acc-list-id-error', 'Customer List ID is required.');
            return;
        }
        clearError('acc-list-id', 'acc-list-id-error');
        if (fullRunning) return;

        fullStartBtn.disabled    = true;
        fullStartBtn.textContent = 'Checking attributes...';

        runPreflightThenMigrate(function () {
            fullRunning   = true;
            fullBuilt     = 0; fullFailed = 0; fullFiles = 0;

            fullStartBtn.textContent    = 'Building...';
            fullStatusBox.style.display = 'none';
            fullOverallEl.textContent   = '';
            fullPhaseList.style.display = 'block';

            setPhase('full', 'build',  'pending', '', 0);
            setPhase('full', 'import', 'pending', null, 0);

            runFullBatch(0, 0);
        });
    });

}());
</script>

</body>
</html>
