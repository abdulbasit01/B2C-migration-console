<isdecorate template="application/MenuFrame">
<iscontent type="text/html" charset="UTF-8"/>
<link rel="stylesheet" href="${pdict.cssUrl}"/>
<div class="acc-page">
<div class="acc-shell">
    <header class="acc-header">
        <h1 class="acc-header__title">${pdict.title}</h1>
        <p class="acc-header__subtitle">${pdict.subtitle}</p>
    </header>

    <main class="acc-wizard-card">
        <p class="acc-step-panel__intro">
            Configure Shopify credentials under
            <strong>${pdict.prefsHint}</strong>.
            This page no longer collects or stores secrets.
        </p>

        <isif condition="${pdict.connectionSummary}">
            <div class="acc-form" style="margin-top:16px;">
                <isloop items="${pdict.connectionSummary.lines}" var="line">
                    <div class="acc-form__group" style="margin-bottom:8px;">
                        <div class="acc-form__label">${line.label}</div>
                        <div class="acc-form__input" style="background:#f3f2f2;border:1px solid #dddbda;">${line.value}</div>
                    </div>
                </isloop>
                <isif condition="${pdict.connectionSummary.configured}">
                    <div class="acc-status acc-status--success" role="status">Shopify credentials are configured in Site Preferences.</div>
                <iselse/>
                    <div class="acc-status acc-status--error" role="status">Shopify credentials are not configured yet.</div>
                </isif>
            </div>
        </isif>
    </main>

    <footer class="acc-wizard-footer">
        <a class="acc-btn acc-btn--primary" href="${pdict.dashboardUrl}">Back to dashboard</a>
    </footer>
</div>
</div>
</isdecorate>
