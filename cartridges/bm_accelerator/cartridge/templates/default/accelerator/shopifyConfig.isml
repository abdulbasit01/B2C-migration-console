<isdecorate template="application/MenuFrame">
<iscontent type="text/html" charset="UTF-8"/>
<link rel="stylesheet" href="${pdict.cssUrl}"/>
<div class="acc-page">
<div class="acc-shell">

    <header class="acc-header">
        <div class="acc-header__inner">
            <div class="acc-header__brand">
                <span class="acc-header__logo">&#9650;</span>
                <span class="acc-header__title">${pdict.title}</span>
            </div>
            <nav class="acc-header__nav">
                <a href="${pdict.dashboardUrl}" class="acc-header__nav-link">&#8592; Dashboard</a>
            </nav>
        </div>
    </header>

    <main class="acc-wizard-card" style="max-width:560px;margin:2rem auto;">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:1.5rem;">
            <span style="width:40px;height:40px;border-radius:50%;background:#96bf48;display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.2rem;font-weight:700;">S</span>
            <div>
                <div style="font-size:1.1rem;font-weight:600;color:#16325c;">Shopify Configuration</div>
                <div style="font-size:0.85rem;color:#54698d;">Store credentials saved to IMPEX and used for all Shopify migrations</div>
            </div>
        </div>

        <form id="shopify-config-form" autocomplete="off">
            <div class="acc-form__group">
                <label class="acc-form__label" for="sc-storeUrl">
                    Store URL <span class="acc-required">*</span>
                </label>
                <input
                    class="acc-form__input"
                    id="sc-storeUrl"
                    name="storeUrl"
                    type="text"
                    value="${pdict.storeUrl}"
                    placeholder="https://your-store.myshopify.com"
                    required="required"
                />
            </div>

            <div class="acc-form__group">
                <label class="acc-form__label" for="sc-clientId">
                    Admin API Client ID <span class="acc-required">*</span>
                </label>
                <input
                    class="acc-form__input"
                    id="sc-clientId"
                    name="clientId"
                    type="text"
                    value="${pdict.clientId}"
                    placeholder="Shopify Admin API client ID"
                    required="required"
                />
            </div>

            <div class="acc-form__group">
                <label class="acc-form__label" for="sc-clientSecret">
                    Admin API Access Token <span class="acc-required">*</span>
                </label>
                <input
                    class="acc-form__input"
                    id="sc-clientSecret"
                    name="clientSecret"
                    type="password"
                    value=""
                    placeholder="${pdict.hasSecret ? '••••••••  (leave blank to keep saved token)' : 'shpat_...'}"
                />
                <isif condition="${pdict.hasSecret}">
                    <p style="font-size:0.8rem;color:#2e7d32;margin-top:4px;">&#10003; Access token already saved. Enter a new value to replace it.</p>
                </isif>
            </div>

            <div class="acc-form__group">
                <label class="acc-form__label" for="sc-apiVersion">API Version</label>
                <input
                    class="acc-form__input"
                    id="sc-apiVersion"
                    name="apiVersion"
                    type="text"
                    value="${pdict.apiVersion}"
                    placeholder="2025-01"
                />
            </div>
        </form>

        <div id="sc-status" style="margin:1rem 0;padding:10px 14px;border-radius:6px;display:none;font-size:0.9rem;"></div>

        <div style="display:flex;gap:12px;margin-top:1.5rem;">
            <button type="button" id="sc-btn-test" class="acc-btn" style="background:#f4f6f9;color:#16325c;border:1px solid #dddbda;">
                Test Connection
            </button>
            <button type="button" id="sc-btn-save" class="acc-btn acc-btn--primary">
                Save &amp; Test Connection
            </button>
        </div>
    </main>

</div>
</div>

<script>
(function () {
    var SAVE_URL = '${pdict.saveConfigUrl}';

    function showStatus(msg, isError, isSuccess) {
        var el = document.getElementById('sc-status');
        el.textContent = msg;
        el.style.display = 'block';
        el.style.background = isError ? '#fce8e8' : isSuccess ? '#e8f5e9' : '#e8f0fe';
        el.style.color      = isError ? '#c62828' : isSuccess ? '#2e7d32' : '#1a73e8';
        el.style.border     = '1px solid ' + (isError ? '#f5c6c6' : isSuccess ? '#c8e6c9' : '#c5d7f5');
    }

    function buildParams(keepBlankSecret) {
        var storeUrl     = document.getElementById('sc-storeUrl').value.trim();
        var clientId     = document.getElementById('sc-clientId').value.trim();
        var clientSecret = document.getElementById('sc-clientSecret').value.trim();
        var apiVersion   = document.getElementById('sc-apiVersion').value.trim() || '2025-01';
        var params = 'storeUrl='     + encodeURIComponent(storeUrl)
                   + '&clientId='     + encodeURIComponent(clientId)
                   + '&apiVersion='   + encodeURIComponent(apiVersion);
        if (clientSecret || !keepBlankSecret) {
            params += '&clientSecret=' + encodeURIComponent(clientSecret);
        }
        return params;
    }

    function doPost(params, btn, onDone) {
        btn.disabled = true;
        var xhr = new XMLHttpRequest();
        xhr.open('POST', SAVE_URL, true);
        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        xhr.onreadystatechange = function () {
            if (xhr.readyState !== 4) return;
            btn.disabled = false;
            var data;
            try { data = JSON.parse(xhr.responseText); } catch (e) { data = { ok: false, error: 'Invalid response' }; }
            onDone(data);
        };
        xhr.send(params);
    }

    document.getElementById('sc-btn-test').addEventListener('click', function () {
        showStatus('Testing connection...', false, false);
        doPost(buildParams(true), this, function (data) {
            if (!data.ok) { showStatus('Connection failed: ' + (data.error || 'Unknown error'), true, false); return; }
            var name = data.project && data.project.name ? data.project.name : (data.project && data.project.key ? data.project.key : '');
            showStatus('Connection successful' + (name ? ' — ' + name : '') + '. Click "Save & Test" to persist credentials.', false, true);
        });
    });

    document.getElementById('sc-btn-save').addEventListener('click', function () {
        var secretEl = document.getElementById('sc-clientSecret');
        var hasSecret = ${pdict.hasSecret ? 'true' : 'false'};
        if (!secretEl.value.trim() && !hasSecret) {
            showStatus('Access Token is required.', true, false);
            return;
        }
        showStatus('Saving and testing...', false, false);
        doPost(buildParams(true), this, function (data) {
            if (!data.ok) { showStatus('Save failed: ' + (data.error || 'Unknown error'), true, false); return; }
            var name = data.project && data.project.name ? data.project.name : (data.project && data.project.key ? data.project.key : '');
            showStatus('Saved successfully' + (name ? ' — connected to ' + name : '') + '.', false, true);
        });
    });
}());
</script>
</isdecorate>
