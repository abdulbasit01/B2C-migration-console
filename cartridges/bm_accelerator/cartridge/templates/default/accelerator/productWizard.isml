<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>${pdict.title} — Product Migration</title>
    <link rel="stylesheet" href="${pdict.cssUrl}"/>
</head>
<body class="acc-page acc-page--wizard">
    <div class="acc-shell">
        <isinclude template="accelerator/components/header"/>

        <a class="acc-back" href="${pdict.dashboardUrl}">
            &larr; Back to Dashboard
        </a>

        <isinclude template="accelerator/components/stepper"/>

        <main class="acc-wizard-card">
            <isif condition="${pdict.wizardStep.key === 'prod-connect'}">
                <isinclude template="accelerator/components/stepProdConnect"/>
            <iselseif condition="${pdict.wizardStep.key === 'prod-fetch'}"/>
                <isinclude template="accelerator/components/stepProdFetch"/>
            <iselseif condition="${pdict.wizardStep.key === 'prod-configure'}"/>
                <isinclude template="accelerator/components/stepProdConfigure"/>
            <iselseif condition="${pdict.wizardStep.key === 'prod-move'}"/>
                <isinclude template="accelerator/components/stepProdMove"/>
            <iselse/>
                <isinclude template="accelerator/components/stepProdView"/>
            </isif>
        </main>

        <footer class="acc-wizard-footer">
            <isif condition="${pdict.prevStep !== null}">
                <a class="acc-btn acc-btn--ghost"
                   href="${pdict.wizardBaseUrl}?step=${pdict.prevStep}">
                    Previous
                </a>
            <iselse/>
                <span></span>
            </isif>

            <isif condition="${pdict.isLastStep}">
                <a class="acc-btn acc-btn--primary" href="${pdict.dashboardUrl}">
                    Finish
                </a>
            <iselseif condition="${pdict.nextStep !== null}"/>
                <a id="acc-next-btn"
                   class="acc-btn acc-btn--primary${pdict.wizardStep.key === 'prod-move' ? ' acc-btn--disabled' : ''}">
                    Continue
                </a>
            </isif>
        </footer>
    </div>
</body>
</html>
