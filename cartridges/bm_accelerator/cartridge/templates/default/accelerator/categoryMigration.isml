<isdecorate template="application/MenuFrame">
<iscontent type="text/html" charset="UTF-8"/>
<link rel="stylesheet" href="${pdict.cssUrl}"/>
<div class="acc-page">
<div class="acc-shell">
<isinclude template="accelerator/components/header"/>
<div style="padding:10px 32px 0;">
<a href="${pdict.dashboardUrl}" style="font-size:13px;color:#0070d2;text-decoration:none;">Back to Dashboard</a>
</div>
<section class="acc-section">
<header class="acc-section__head">
<h2>Category Data Migration - Commercetools to SFCC</h2>
</header>

<div style="background:#f4f6f9;border:1px solid #dddbda;border-radius:4px;padding:16px 20px;margin-bottom:20px;">
<div style="display:flex;align-items:flex-end;flex-wrap:wrap;gap:12px;">

<div>
<label for="cat-catalog-select" style="display:block;font-weight:600;font-size:13px;margin-bottom:4px;">Target Storefront Catalog</label>
<div style="display:flex;gap:8px;align-items:center;">
<select id="cat-catalog-select" class="acc-form__input" style="width:280px;padding:6px 8px;font-size:13px;border:1px solid #dddbda;border-radius:4px;">
<option value="">-- Select a catalog --</option>
</select>
<button type="button" id="btn-load-catalogs" class="acc-btn acc-btn--ghost" style="white-space:nowrap;font-size:12px;padding:6px 12px;">Load Catalogs</button>
<span id="catalog-load-status" style="font-size:12px;color:#54698d;"></span>
</div>
</div>
<div>
<label for="cat-catalog-id" style="display:block;font-weight:600;font-size:13px;margin-bottom:4px;">Or enter Catalog ID manually</label>
<input id="cat-catalog-id" type="text" class="acc-form__input" placeholder="e.g. storefront-catalog-m-en" value="${pdict.catalogId}" style="width:240px;"/>
</div>
</div>
<div style="margin-top:10px;font-size:12px;color:#54698d;">Selecting from dropdown will auto-fill the Catalog ID. Manual entry overrides the selection.</div>
</div>

<div style="display:flex;border-bottom:2px solid #dddbda;margin-bottom:24px;flex-wrap:wrap;">
<div id="tab-1" style="padding:10px 20px;font-size:13px;font-weight:600;color:#0070d2;border-bottom:3px solid #0070d2;cursor:pointer;margin-bottom:-2px;">Step 1 - Check Attributes</div>
<div id="tab-2" style="padding:10px 20px;font-size:13px;font-weight:600;color:#54698d;cursor:pointer;margin-bottom:-2px;">Step 2 - Edit Hierarchy</div>
<div id="tab-3" style="padding:10px 20px;font-size:13px;font-weight:600;color:#54698d;cursor:pointer;margin-bottom:-2px;">Step 3 - Export</div>
</div>

<!-- STEP 1 -->
<div id="panel-step1">
<div id="step1-info-box" style="background:#f4f6f9;border:1px solid #dddbda;border-radius:4px;padding:14px 18px;font-size:13px;margin-bottom:16px;">Click Check Attributes to see which custom attributes exist on the Category system object.</div>
<div id="attr-result" style="display:none;margin-bottom:16px;">
<table style="width:100%;border-collapse:collapse;font-size:13px;margin-bottom:10px;">
<thead><tr>
<th style="background:#f4f6f9;padding:8px 12px;text-align:center;border:1px solid #dddbda;font-weight:600;color:#16325c;width:52px;">Create</th>
<th style="background:#f4f6f9;padding:8px 12px;text-align:left;border:1px solid #dddbda;font-weight:600;color:#16325c;">Attribute ID</th>
<th style="background:#f4f6f9;padding:8px 12px;text-align:left;border:1px solid #dddbda;font-weight:600;color:#16325c;">Type</th>
<th style="background:#f4f6f9;padding:8px 12px;text-align:left;border:1px solid #dddbda;font-weight:600;color:#16325c;">Label</th>
<th style="background:#f4f6f9;padding:8px 12px;text-align:left;border:1px solid #dddbda;font-weight:600;color:#16325c;">Status</th>
</tr></thead>
<tbody id="attr-tbody"></tbody>
</table>
<div style="display:flex;gap:8px;margin-bottom:12px;">
<button type="button" id="btn-select-all-attrs" class="acc-btn acc-btn--ghost" style="font-size:12px;padding:4px 12px;">Select All</button>
<button type="button" id="btn-deselect-all-attrs" class="acc-btn acc-btn--ghost" style="font-size:12px;padding:4px 12px;">Deselect All</button>
<button type="button" id="btn-revert-attrs" class="acc-btn acc-btn--ghost" style="font-size:12px;padding:4px 12px;">Revert to Default</button>
</div>
<div id="attr-warnings" style="display:none;background:#fff3e0;border:1px solid #ffb300;border-radius:4px;padding:10px 14px;font-size:13px;margin-bottom:8px;color:#e65100;"></div>
<div id="attr-errors"   style="display:none;background:#ffebee;border:1px solid #c62828;border-radius:4px;padding:10px 14px;font-size:13px;margin-bottom:8px;color:#c62828;"></div>
</div>
<div class="acc-move-actions">
<button type="button" id="btn-check-attrs" class="acc-btn acc-btn--primary">Check Attributes</button>
<button type="button" id="btn-create-selected-attrs" class="acc-btn acc-btn--primary" style="display:none;margin-left:10px;">Create Selected</button>
<button type="button" id="btn-skip-attrs" class="acc-btn acc-btn--ghost" style="margin-left:10px;">Skip to Step 2</button>
<span id="attr-overall" style="margin-left:14px;font-size:13px;color:#54698d;"></span>
</div>

<div style="margin-top:28px;border-top:1px solid #dddbda;padding-top:20px;">
<div style="font-weight:600;font-size:14px;color:#16325c;margin-bottom:12px;">New Catalog</div>
<div style="background:#f4f6f9;border:1px solid #dddbda;border-radius:4px;padding:14px 18px;font-size:13px;margin-bottom:20px;">
Create a new SFCC storefront catalog. Fill in the Catalog ID and Name then click Generate XML to create an IMPEX file for manual import.
</div>
<div style="background:#fff;border:1px solid #dddbda;border-radius:4px;padding:20px 24px;margin-bottom:20px;max-width:520px;">
<div style="margin-bottom:16px;">
<label for="new-catalog-id" style="display:block;font-weight:600;font-size:13px;margin-bottom:6px;">Catalog ID</label>
<input id="new-catalog-id" type="text" class="acc-form__input" placeholder="e.g. my-storefront-catalog" style="width:100%;padding:8px 10px;font-size:13px;border:1px solid #dddbda;border-radius:4px;"/>
<div id="new-catalog-id-error" style="display:none;color:#c62828;font-size:12px;margin-top:4px;">Catalog ID is required.</div>
</div>
<div style="margin-bottom:20px;">
<label for="new-catalog-name" style="display:block;font-weight:600;font-size:13px;margin-bottom:6px;">Catalog Name</label>
<input id="new-catalog-name" type="text" class="acc-form__input" placeholder="e.g. My Storefront Catalog" style="width:100%;padding:8px 10px;font-size:13px;border:1px solid #dddbda;border-radius:4px;"/>
<div id="new-catalog-name-error" style="display:none;color:#c62828;font-size:12px;margin-top:4px;">Catalog Name is required.</div>
</div>
<button type="button" id="btn-create-catalog" class="acc-btn acc-btn--primary">Generate XML (IMPEX)</button>
<span id="new-catalog-status" style="margin-left:14px;font-size:13px;color:#54698d;"></span>
</div>
<div id="new-catalog-result" style="display:none;background:#e8f5e9;border:1px solid #2e7d32;border-radius:4px;padding:16px 20px;max-width:520px;">
<div style="font-weight:600;color:#2e7d32;margin-bottom:8px;">Catalog XML generated successfully.</div>
<div style="font-size:12px;color:#54698d;margin-bottom:6px;">File location:</div>
<code id="new-catalog-xml-path" style="background:#e0e5ee;padding:4px 8px;border-radius:3px;font-size:12px;display:block;margin-bottom:14px;word-break:break-all;"></code>
<div style="display:flex;gap:10px;flex-wrap:wrap;padding-top:12px;border-top:1px solid #c8e6c9;">
<a id="btn-new-catalog-impex" href="#" class="acc-btn acc-btn--secondary" style="text-decoration:none;">Open IMPEX Folder</a>
<a id="btn-new-catalog-import" href="#" class="acc-btn acc-btn--primary" style="text-decoration:none;margin-left:10px;">Go to Catalog Import</a>
</div>
</div>
</div>
</div>

<!-- STEP 2 -->
<div id="panel-step2" style="display:none;">
<div style="background:#f4f6f9;border:1px solid #dddbda;border-radius:4px;padding:14px 18px;font-size:13px;margin-bottom:16px;">
Step 2 of 3 - Edit Category Hierarchy and Sort Order.
Grab the arrow icon on any row and drag it up or down to reorder or change level.
Drop on top half of a row = place before it at same level.
Drop on bottom half = make it a child of that row.
Drop on the blue zone = make it a root L1 category.
Use the Parent dropdown to change parent directly.
Use the level filter buttons to view categories by level.
Click Save and Apply Changes to confirm.
</div>
<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px;">
<input type="text" id="hierarchy-search" placeholder="Search by name or ID" style="width:220px;padding:6px 10px;font-size:13px;border:1px solid #dddbda;border-radius:4px;"/>
<button type="button" id="btn-load-categories" class="acc-btn acc-btn--secondary">Load Categories from CT</button>
<button type="button" id="btn-reset-hierarchy" class="acc-btn acc-btn--ghost">Reset All</button>
<button type="button" id="btn-save-hierarchy" class="acc-btn acc-btn--primary">Save and Apply Changes</button>
<span id="hierarchy-fetch-status" style="font-size:13px;color:#54698d;"></span>
</div>
<div style="display:flex;align-items:flex-end;gap:10px;flex-wrap:wrap;margin-bottom:12px;padding:12px 14px;background:#f4f6f9;border:1px solid #dddbda;border-radius:4px;">
<div>
<label for="ct-new-cat-key" style="display:block;font-size:12px;font-weight:600;margin-bottom:4px;">Category Key</label>
<input id="ct-new-cat-key" type="text" placeholder="e.g. new-bedding" style="padding:6px 8px;font-size:13px;border:1px solid #dddbda;border-radius:4px;width:160px;"/>
</div>
<div>
<label for="ct-new-cat-name" style="display:block;font-size:12px;font-weight:600;margin-bottom:4px;">Display Name</label>
<input id="ct-new-cat-name" type="text" placeholder="e.g. Bedding" style="padding:6px 8px;font-size:13px;border:1px solid #dddbda;border-radius:4px;width:160px;"/>
</div>
<div>
<label for="ct-new-cat-parent" style="display:block;font-size:12px;font-weight:600;margin-bottom:4px;">Parent Category (optional)</label>
<select id="ct-new-cat-parent" style="padding:6px 8px;font-size:13px;border:1px solid #dddbda;border-radius:4px;width:200px;">
<option value="">-- Root (no parent) --</option>
</select>
</div>
<button type="button" id="btn-create-ct-category" class="acc-btn acc-btn--primary" style="white-space:nowrap;">Add to List</button>
<span id="ct-new-cat-status" style="font-size:12px;color:#54698d;"></span>
</div>
<div id="level-filter-tabs" style="display:none;gap:6px;flex-wrap:wrap;margin-bottom:12px;"></div>
<div id="hierarchy-changes-summary" style="display:none;background:#e8f4fd;border:1px solid #0070d2;border-radius:4px;padding:10px 14px;font-size:13px;margin-bottom:10px;color:#0070d2;">
<strong id="hierarchy-changes-count">0</strong> unsaved change(s). Click Save and Apply Changes to confirm.
</div>
<div id="hierarchy-applied-summary" style="display:none;background:#e8f5e9;border:1px solid #2e7d32;border-radius:4px;padding:10px 14px;font-size:13px;margin-bottom:10px;color:#2e7d32;">
<strong id="hierarchy-applied-count">0</strong> change(s) applied and ready for export.
</div>
<div id="root-drop-zone" style="display:none;border:2px dashed #0070d2;border-radius:6px;padding:12px 20px;text-align:center;color:#0070d2;font-size:13px;font-weight:600;margin-bottom:10px;background:#f0f7ff;">
Drop here to make Root (L1) category
</div>
<div style="border:1px solid #dddbda;border-radius:4px;max-height:520px;overflow-y:auto;">
<table style="width:100%;border-collapse:collapse;font-size:13px;">
<thead><tr>
<th style="background:#f4f6f9;padding:8px 10px;text-align:center;border-bottom:2px solid #dddbda;font-weight:600;color:#16325c;font-size:12px;width:32px;"></th>
<th style="background:#f4f6f9;padding:8px 10px;text-align:left;border-bottom:2px solid #dddbda;font-weight:600;color:#16325c;font-size:12px;width:48px;">Level</th>
<th style="background:#f4f6f9;padding:8px 10px;text-align:left;border-bottom:2px solid #dddbda;font-weight:600;color:#16325c;font-size:12px;width:38px;">Pos</th>
<th style="background:#f4f6f9;padding:8px 10px;text-align:left;border-bottom:2px solid #dddbda;font-weight:600;color:#16325c;font-size:12px;">Category ID</th>
<th style="background:#f4f6f9;padding:8px 10px;text-align:left;border-bottom:2px solid #dddbda;font-weight:600;color:#16325c;font-size:12px;">Name</th>
<th style="background:#f4f6f9;padding:8px 10px;text-align:left;border-bottom:2px solid #dddbda;font-weight:600;color:#16325c;font-size:12px;">Parent</th>
</tr></thead>
<tbody id="main-cat-tbody">
<tr><td colspan="6" style="text-align:center;padding:30px;color:#54698d;">Click Load Categories from CT to begin.</td></tr>
</tbody>
</table>
</div>
<div class="acc-move-actions" style="margin-top:14px;">
<button type="button" id="btn-back-to-step1" class="acc-btn acc-btn--ghost">Back</button>
<button type="button" id="btn-next-to-step3" class="acc-btn acc-btn--primary" style="margin-left:10px;">Next - Export</button>
</div>
</div>

<!-- STEP 3 -->
<div id="panel-step3" style="display:none;">
<div id="step3-summary" style="background:#f4f6f9;border:1px solid #dddbda;border-radius:4px;padding:14px 18px;font-size:13px;margin-bottom:20px;">Step 3 of 3 - Export. Ready to migrate.</div>
<ul class="acc-phases" id="cat-phase-list" style="display:none;margin-bottom:24px;">
<li class="acc-phases__item acc-phases__item--pending" id="cat-phase-fetch">
<div class="acc-phases__head"><span>Phase 1 - Fetch and Transform Categories</span><span class="acc-phases__status" id="cat-status-fetch">pending</span></div>
<p class="acc-phases__detail" id="cat-detail-fetch"></p>
<div class="acc-progress"><div class="acc-progress__bar" id="cat-bar-fetch" style="width:0%"></div></div>
</li>
<li class="acc-phases__item acc-phases__item--pending" id="cat-phase-import">
<div class="acc-phases__head"><span>Phase 2 - Write XML to IMPEX</span><span class="acc-phases__status" id="cat-status-import">pending</span></div>
<p class="acc-phases__detail" id="cat-detail-import">Waiting for Phase 1</p>
<div class="acc-progress"><div class="acc-progress__bar" id="cat-bar-import" style="width:0%"></div></div>
<div id="cat-xml-controls" style="display:none;margin-top:12px;padding:14px;background:#f4f6f9;border:1px solid #dddbda;border-radius:4px;">
<div style="font-weight:600;color:#16325c;margin-bottom:8px;">XML written to IMPEX successfully.</div>
<div style="font-size:12px;color:#54698d;margin-bottom:6px;">File location:</div>
<code id="cat-xml-path" style="background:#e0e5ee;padding:4px 8px;border-radius:3px;font-size:12px;display:block;margin-bottom:14px;word-break:break-all;"></code>
<div style="display:flex;gap:10px;flex-wrap:wrap;padding-top:12px;border-top:1px solid #dddbda;">
<a id="btn-open-impex" href="#" class="acc-btn acc-btn--secondary" style="text-decoration:none;">Open IMPEX Folder</a>
<a id="btn-open-import" href="#" class="acc-btn acc-btn--primary" style="text-decoration:none;margin-left:10px;">Go to Catalog Import</a>
</div>
<div style="margin-top:12px;font-size:12px;color:#54698d;line-height:1.8;">
Next steps: 1. Click Open IMPEX Folder. 2. Click Go to Catalog Import. 3. Select the file and run the import job.
</div>
</div>
</li>
</ul>
<div id="cat-move-status" style="display:none;padding:12px 16px;border-radius:4px;margin-bottom:16px;font-size:13px;"></div>
<div class="acc-move-actions">
<button type="button" id="btn-back-to-step2" class="acc-btn acc-btn--ghost">Back</button>
<button type="button" id="cat-start-btn" class="acc-btn acc-btn--primary" style="margin-left:10px;">Run Migration</button>
<span id="cat-move-overall" style="margin-left:14px;font-size:13px;color:#54698d;"></span>
</div>
</div>


</section>
</div>

<script>
(function() {
    function initApp() {
        if (typeof _APP !== 'undefined' && typeof _APP.init === 'function') {
            _APP.MIGRATE_URL         = '${pdict.migrateUrl}';
            _APP.FETCH_URL           = '${pdict.fetchUrl}';
            _APP.ATTRS_URL           = '${pdict.checkAttrsUrl}';
            _APP.STATUS_URL          = '${pdict.checkStatusUrl}';
            _APP.IMPEX_URL           = '${pdict.impexFolderUrl}';
            _APP.FETCH_CATALOGS_URL  = '${pdict.fetchCatalogsUrl}';
            _APP.CREATE_CATALOG_URL       = '${pdict.createCatalogUrl}';
            _APP.CREATE_CATEGORY_URL      = '${pdict.createCategoryUrl}';
            _APP.BM_CLIENT_ID             = ('${pdict.bmClientId}'.replace(/a/g,'').length === 0) ? 'aacf8c92-9166-479f-ba97-a7df6360a1ad' : '${pdict.bmClientId}';
            _APP.META_VERSION             = '${pdict.metaVersion}';
            _APP.IMPORT_URL              = '${pdict.importUrl}';
            _APP.CREATE_CT_CATEGORY_URL  = '${pdict.createCtCategoryUrl}';
            _APP.init();
        } else {
            setTimeout(initApp, 50);
        }
    }
    var jsScript = document.createElement('script');
    jsScript.src = '${pdict.jsUrl}';
    jsScript.onload = function() { initApp(); };
    jsScript.onerror = function() { console.error('Failed to load categoryMigration JS from: ${pdict.jsUrl}'); };
    document.head.appendChild(jsScript);
}());
</script>
</div>
</div>
</isdecorate>

