<isdecorate template="application/MenuFrame">
<iscontent type="text/html" charset="UTF-8"/>
<link rel="stylesheet" href="${pdict.cssUrl}"/>
<div class="acc-page">
<div class="acc-shell">

    <isinclude template="accelerator/components/header"/>

    <div style="padding:10px 32px 0;">
        <a href="${pdict.dashboardUrl}" style="font-size:13px;color:#0070d2;text-decoration:none;">&larr; Back to Dashboard</a>
    </div>

    <section class="acc-section">
        <header class="acc-section__head">
            <h2>Category Migration &mdash; <span class="acc-highlight">Commercetools &rarr; SFCC</span></h2>
            <p style="font-size:14px;color:#54698d;margin-top:6px;max-width:640px;">
                Migrates Commercetools categories to SFCC catalog categories.
                Custom attributes <code>ctId</code>, <code>ctSlug</code>, and <code>ctPosition</code>
                must exist on the SFCC Category system object before importing.
            </p>
        </header>

        <!-- ── Attribute Pre-flight Panel ── -->
        <div id="cat-attr-preflight" style="background:#f4f6f9;border:1px solid #dddbda;border-radius:6px;padding:20px 24px;margin-bottom:24px;">
            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
                <div>
                    <h3 style="margin:0 0 4px;font-size:15px;color:#16325c;">SFCC Category Attribute Pre-flight</h3>
                    <p style="margin:0;font-size:13px;color:#54698d;">
                        Verify that <code>ctId</code>, <code>ctSlug</code>, and <code>ctPosition</code>
                        are defined on the SFCC Category system object. Create any missing ones below.
                    </p>
                </div>
                <button id="cat-check-attrs-btn" type="button" class="acc-btn acc-btn--ghost" style="white-space:nowrap;">
                    Check Category Attributes
                </button>
            </div>

            <div id="cat-attr-status" style="display:none;margin-top:14px;"></div>

            <div id="cat-attr-missing-wrap" style="display:none;margin-top:14px;">
                <p style="font-size:13px;color:#c62828;margin:0 0 10px;">
                    The following attributes are missing in SFCC Category system object:
                </p>
                <table style="width:100%;border-collapse:collapse;font-size:13px;">
                    <thead>
                        <tr style="background:#e0e5ee;">
                            <th style="padding:8px 10px;text-align:left;width:32px;">
                                <input type="checkbox" id="cat-attr-select-all" title="Select all"/>
                            </th>
                            <th style="padding:8px 10px;text-align:left;">Attribute ID</th>
                            <th style="padding:8px 10px;text-align:left;">Label</th>
                            <th style="padding:8px 10px;text-align:left;">SFCC Type</th>
                        </tr>
                    </thead>
                    <tbody id="cat-attr-missing-body"></tbody>
                </table>
                <div style="display:flex;gap:10px;margin-top:14px;align-items:center;">
                    <button id="cat-create-attrs-btn" type="button" class="acc-btn acc-btn--primary" disabled>
                        Create Selected Attributes
                    </button>
                    <span id="cat-create-status" style="font-size:13px;color:#54698d;"></span>
                </div>
            </div>

            <div id="cat-attr-ok-badge" style="display:none;margin-top:12px;color:#2e7d32;font-size:13px;font-weight:600;">
                &#10003; All required SFCC Category attributes are present. Ready to migrate.
            </div>
        </div>

        <!-- ── Migration Panel ── -->
        <div style="background:#f4f6f9;border:1px solid #dddbda;border-radius:6px;padding:20px 24px;margin-bottom:24px;">
            <h3 style="margin:0 0 12px;font-size:15px;color:#16325c;">Run Category Migration</h3>
            <p style="font-size:13px;color:#54698d;margin:0 0 16px;">
                Fetches all categories from Commercetools and migrates them into SFCC.
                Run the attribute pre-flight check above before starting.
            </p>

            <ul class="acc-phases" id="cat-phase-list" style="display:none;margin-bottom:24px;">
                <li class="acc-phases__item acc-phases__item--pending" id="cat-phase-migrate">
                    <div class="acc-phases__head">
                        <span>Migrating Categories</span>
                        <span class="acc-phases__status" id="cat-status-migrate">pending</span>
                    </div>
                    <p class="acc-phases__detail" id="cat-detail-migrate"></p>
                    <div class="acc-progress">
                        <div class="acc-progress__bar" id="cat-bar-migrate" style="width:0%"></div>
                    </div>
                </li>
            </ul>

            <div id="cat-move-status" class="acc-callout acc-callout--info" style="display:none;margin-bottom:20px;"></div>

            <div class="acc-move-actions">
                <button type="button" id="cat-start-btn" class="acc-btn acc-btn--primary">
                    &#9654; Start Category Migration
                </button>
                <span id="cat-move-overall" style="margin-left:14px;font-size:13px;color:#54698d;"></span>
            </div>
        </div>

    </section>
</div>

<script>
(function () {
    var CHECK_ATTRS_URL  = '${pdict.checkAttrsUrl}';
    var CREATE_ATTRS_URL = '${pdict.createAttrsUrl}';
    var MIGRATE_URL      = '${pdict.migrateUrl}';

    function post(url, params, onDone) {
        var req = new XMLHttpRequest();
        req.open('POST', url, true);
        req.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        req.onreadystatechange = function () {
            if (req.readyState !== 4) return;
            var data;
            try { data = JSON.parse(req.responseText); } catch (e) { data = { ok: false, error: 'Parse error' }; }
            onDone(data);
        };
        req.send(params || '');
    }

    function setPhase(id, state, detail, pct) {
        var li  = document.getElementById('cat-phase-' + id);
        var st  = document.getElementById('cat-status-' + id);
        var det = document.getElementById('cat-detail-' + id);
        var bar = document.getElementById('cat-bar-' + id);
        if (!li) return;
        li.className = 'acc-phases__item acc-phases__item--' + state;
        if (st)  st.textContent  = state;
        if (det && detail !== null) det.textContent = detail || '';
        if (bar) bar.style.width = (pct || 0) + '%';
    }

    // ── Attribute Pre-flight ─────────────────────────────────────────────────

    var checkAttrsBtn   = document.getElementById('cat-check-attrs-btn');
    var attrStatus      = document.getElementById('cat-attr-status');
    var attrMissingWrap = document.getElementById('cat-attr-missing-wrap');
    var attrMissingBody = document.getElementById('cat-attr-missing-body');
    var attrOkBadge     = document.getElementById('cat-attr-ok-badge');
    var createAttrsBtn  = document.getElementById('cat-create-attrs-btn');
    var createStatus    = document.getElementById('cat-create-status');
    var selectAllCb     = document.getElementById('cat-attr-select-all');

    var missingList = [];

    function showAttrStatus(msg, color) {
        attrStatus.textContent   = msg;
        attrStatus.style.color   = color || '#54698d';
        attrStatus.style.display = 'block';
    }

    function updateCreateBtn() {
        var checked = attrMissingBody.querySelectorAll('input[type="checkbox"]:checked');
        createAttrsBtn.disabled = (checked.length === 0);
    }

    function renderMissingTable(missing) {
        attrMissingBody.innerHTML = '';
        for (var i = 0; i < missing.length; i++) {
            var a  = missing[i];
            var tr = document.createElement('tr');
            tr.style.borderBottom = '1px solid #e0e5ee';
            tr.innerHTML =
                '<td style="padding:8px 10px;"><input type="checkbox" data-idx="' + i + '" checked/></td>' +
                '<td style="padding:8px 10px;font-family:monospace;">' + a.id + '</td>' +
                '<td style="padding:8px 10px;">' + (a.label || '') + '</td>' +
                '<td style="padding:8px 10px;">' + (a.sfccType || 'string') + '</td>';
            attrMissingBody.appendChild(tr);
        }
        var cbs = attrMissingBody.querySelectorAll('input[type="checkbox"]');
        for (var c = 0; c < cbs.length; c++) {
            cbs[c].addEventListener('change', updateCreateBtn);
        }
        updateCreateBtn();
    }

    if (selectAllCb) {
        selectAllCb.addEventListener('change', function () {
            var cbs = attrMissingBody.querySelectorAll('input[type="checkbox"]');
            for (var c = 0; c < cbs.length; c++) cbs[c].checked = selectAllCb.checked;
            updateCreateBtn();
        });
    }

    checkAttrsBtn.addEventListener('click', function () {
        checkAttrsBtn.disabled        = true;
        attrMissingWrap.style.display = 'none';
        attrOkBadge.style.display     = 'none';
        showAttrStatus('Checking SFCC Category attribute definitions...', '#54698d');

        post(CHECK_ATTRS_URL, '', function (data) {
            checkAttrsBtn.disabled = false;
            if (!data.ok) {
                showAttrStatus('Error: ' + (data.error || 'Check failed'), '#c62828');
                return;
            }
            missingList = (data.attrs || []).filter(function (a) { return !a.exists; });
            if (missingList.length === 0) {
                attrStatus.style.display  = 'none';
                attrOkBadge.style.display = 'block';
            } else {
                showAttrStatus(missingList.length + ' attribute(s) missing in SFCC Category.', '#c62828');
                renderMissingTable(missingList);
                attrMissingWrap.style.display = 'block';
            }
        });
    });

    createAttrsBtn.addEventListener('click', function () {
        var cbs      = attrMissingBody.querySelectorAll('input[type="checkbox"]:checked');
        var selected = [];
        for (var c = 0; c < cbs.length; c++) {
            var idx = parseInt(cbs[c].getAttribute('data-idx'), 10);
            if (missingList[idx]) selected.push(missingList[idx]);
        }
        if (!selected.length) return;

        createAttrsBtn.disabled  = true;
        createStatus.textContent = 'Creating ' + selected.length + ' attribute(s)...';
        createStatus.style.color = '#54698d';

        post(CREATE_ATTRS_URL, 'attrs=' + encodeURIComponent(JSON.stringify(selected)), function (data) {
            if (!data.ok) {
                createStatus.textContent = 'Error: ' + (data.error || 'Create failed');
                createStatus.style.color = '#c62828';
                createAttrsBtn.disabled  = false;
                return;
            }
            var r = data.result || {};
            createStatus.textContent = (r.created || 0) + ' created'
                + (r.skipped ? ', ' + r.skipped + ' already existed' : '')
                + (r.failed  ? ', ' + r.failed  + ' failed'          : '') + '.';
            createStatus.style.color = r.failed ? '#c62828' : '#2e7d32';
            checkAttrsBtn.click();
        });
    });

    // ── Category Migration ───────────────────────────────────────────────────

    var startBtn   = document.getElementById('cat-start-btn');
    var overall    = document.getElementById('cat-move-overall');
    var moveStatus = document.getElementById('cat-move-status');
    var phaseList  = document.getElementById('cat-phase-list');
    var running    = false;

    startBtn.addEventListener('click', function () {
        if (running) return;
        running = true;
        startBtn.disabled    = true;
        startBtn.textContent = 'Migrating...';
        moveStatus.style.display = 'none';
        overall.textContent      = '';
        phaseList.style.display  = 'block';
        setPhase('migrate', 'active', 'Running...', 10);

        post(MIGRATE_URL, '', function (data) {
            running = false;
            startBtn.disabled    = false;
            if (!data.ok) {
                setPhase('migrate', 'error', data.error || 'Migration failed', 100);
                moveStatus.className   = 'acc-callout acc-callout--warning';
                moveStatus.textContent = 'Migration failed: ' + (data.error || 'See server logs.');
                moveStatus.style.display = 'block';
                startBtn.textContent     = 'Retry';
                return;
            }
            var migrated = data.migrated || 0;
            var failed   = data.failed   || 0;
            var state    = (failed > 0 && migrated === 0) ? 'error' : (failed > 0 ? 'warning' : 'done');
            setPhase('migrate', state, migrated + ' migrated' + (failed ? ', ' + failed + ' failed' : ''), 100);
            moveStatus.className   = failed > 0 ? 'acc-callout acc-callout--warning' : 'acc-callout acc-callout--success';
            moveStatus.textContent = migrated + ' category(-ies) migrated.'
                + (failed ? ' ' + failed + ' failed — check BM logs.' : '');
            moveStatus.style.display = 'block';
            startBtn.textContent     = 'Migration Complete';
        });
    });

}());
</script>

</div>
</div>
</isdecorate>
