<section class="acc-step-panel">
    <h2 class="acc-step-panel__title">
        Step <isprint value="${pdict.currentStep}" formatter="#"/> &mdash;
        <span class="acc-highlight">${Resource.msg('accelerator.ordermigration.configure.title', 'accelerator', null)}</span>
    </h2>
    <p class="acc-step-panel__intro">${Resource.msg('accelerator.ordermigration.configure.intro', 'accelerator', null)}</p>

    <div class="acc-info-panel">
        <h3 class="acc-info-panel__title">${Resource.msg('accelerator.ordermigration.pipeline.heading', 'accelerator', null)}</h3>
        <ol class="acc-pipeline-preview">
            <isloop items="${pdict.exportPhases}" var="phase">
                <li class="acc-pipeline-preview__item">${phase.label}</li>
            </isloop>
        </ol>
    </div>

    <form class="acc-form acc-form--enriched" id="acc-order-config-form" method="post" action="${pdict.orderConfigUrl}">
        <input type="hidden" name="platformId" value="${pdict.platform.id}" />

        <fieldset class="acc-fieldset">
            <legend class="acc-fieldset__legend">${Resource.msg('accelerator.ordermigration.years', 'accelerator', null)}</legend>
            <div class="acc-chip-group" role="radiogroup" aria-label="${Resource.msg('accelerator.ordermigration.years', 'accelerator', null)}">
                <isif condition="${pdict.orderYears == '1'}">
                    <label class="acc-chip acc-chip--selected">
                        <input type="radio" name="years" value="1" checked="checked"/>
                        1 ${Resource.msg('accelerator.ordermigration.year', 'accelerator', null)}
                    </label>
                <iselse/>
                    <label class="acc-chip">
                        <input type="radio" name="years" value="1"/>
                        1 ${Resource.msg('accelerator.ordermigration.year', 'accelerator', null)}
                    </label>
                </isif>
                <isif condition="${pdict.orderYears == '2'}">
                    <label class="acc-chip acc-chip--selected">
                        <input type="radio" name="years" value="2" checked="checked"/>
                        2 ${Resource.msg('accelerator.ordermigration.years.plural', 'accelerator', null)}
                    </label>
                <iselse/>
                    <label class="acc-chip">
                        <input type="radio" name="years" value="2"/>
                        2 ${Resource.msg('accelerator.ordermigration.years.plural', 'accelerator', null)}
                    </label>
                </isif>
                <isif condition="${pdict.orderYears == '3'}">
                    <label class="acc-chip acc-chip--selected">
                        <input type="radio" name="years" value="3" checked="checked"/>
                        3 ${Resource.msg('accelerator.ordermigration.years.plural', 'accelerator', null)}
                    </label>
                <iselse/>
                    <label class="acc-chip">
                        <input type="radio" name="years" value="3"/>
                        3 ${Resource.msg('accelerator.ordermigration.years.plural', 'accelerator', null)}
                    </label>
                </isif>
            </div>
        </fieldset>

        <div class="acc-form__group">
            <label class="acc-form__label" for="order-max-count">${Resource.msg('accelerator.ordermigration.maxcount', 'accelerator', null)}</label>
            <input type="number" id="order-max-count" name="maxCount" class="acc-form__input"
                   min="1" value="${pdict.orderMaxCount}"
                   placeholder="${Resource.msg('accelerator.ordermigration.maxcount.placeholder', 'accelerator', null)}"/>
            <p class="acc-form__hint">${Resource.msg('accelerator.ordermigration.maxcount.hint', 'accelerator', null)}</p>
        </div>
    </form>
</section>