<section class="acc-step-panel">
    <h2 class="acc-step-panel__title">
        Step <isprint value="${pdict.currentStep}" formatter="#"/> &mdash; Connect to <span class="acc-highlight">commercetools</span>
    </h2>
    <p class="acc-step-panel__intro">
        Enter your commercetools API credentials to authenticate and fetch product data.
    </p>

    <form class="acc-form" id="prod-connect-form" action="#" method="post" onsubmit="return false;">
        <input type="hidden" name="platformId" value="commercetools"/>

        <div class="acc-form__group">
            <label class="acc-form__label" for="prod-field-projectKey">Project key <span class="acc-required">*</span></label>
            <input class="acc-form__input" id="prod-field-projectKey" name="projectKey" type="text" value="${pdict.stepContent.projectKey}" required="required"/>
        </div>
        <div class="acc-form__group">
            <label class="acc-form__label" for="prod-field-clientId">Client ID <span class="acc-required">*</span></label>
            <input class="acc-form__input" id="prod-field-clientId" name="clientId" type="text" value="${pdict.stepContent.clientId}" required="required"/>
        </div>
        <div class="acc-form__group">
            <label class="acc-form__label" for="prod-field-clientSecret">Client secret <span class="acc-required">*</span></label>
            <input class="acc-form__input" id="prod-field-clientSecret" name="clientSecret" type="password" value="${pdict.stepContent.clientSecret}" required="required"/>
        </div>
        <div class="acc-form__group">
            <label class="acc-form__label" for="prod-field-apiUrl">API URL <span class="acc-required">*</span></label>
            <input class="acc-form__input" id="prod-field-apiUrl" name="apiUrl" type="text" value="${pdict.stepContent.apiUrl}" required="required"/>
        </div>
        <div class="acc-form__group">
            <label class="acc-form__label" for="prod-field-scopes">Scopes</label>
            <input class="acc-form__input" id="prod-field-scopes" name="scopes" type="text" value="${pdict.stepContent.scopes}"/>
        </div>
    </form>
</section>
