<section class="acc-step-panel">
    <h2 class="acc-step-panel__title">
        Step <isprint value="${pdict.currentStep}" formatter="#"/> &mdash; Connect to <span class="acc-highlight">commercetools</span>
    </h2>
    <p class="acc-step-panel__intro">
        Enter your commercetools API credentials. These are used to authenticate and fetch product data from your CTP project.
    </p>

    <form class="acc-form" id="prod-connect-form" action="#" method="post" onsubmit="return false;">
        <input type="hidden" name="platformId" value="commercetools"/>
        <isloop items="${pdict.platform.connectFields}" var="field">
            <div class="acc-form__group">
                <label class="acc-form__label" for="prod-field-${field.name}">
                    ${field.label}
                    <isif condition="${field.required}"><span class="acc-required">*</span></isif>
                </label>
                <input
                    class="acc-form__input"
                    id="prod-field-${field.name}"
                    name="${field.name}"
                    type="${field.type}"
                    value="${field.value}"
                    <isif condition="${!empty(field.placeholder)}">placeholder="${field.placeholder}"</isif>
                    <isif condition="${field.required}">required="required"</isif>
                />
            </div>
        </isloop>
    </form>

    <div style="margin-top:20px;display:flex;align-items:center;gap:12px;">
        <button type="button" id="prod-test-btn" class="acc-btn acc-btn--ghost">Test Connection</button>
        <span id="prod-connect-status" style="font-size:13px;"></span>
    </div>
</section>

<script>
(function () {
    var TEST_URL = '${URLUtils.url("Accelerator-TestConnection")}';
    var NEXT_URL = '${pdict.wizardBaseUrl}?step=${pdict.nextStep}';

    function post(url, params, onDone) {
        var req = new XMLHttpRequest();
        req.open('POST', url, true);
        req.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        req.onreadystatechange = function () {
            if (req.readyState !== 4) return;
            var data;
            try { data = JSON.parse(req.responseText); } catch (e) { data = { ok: false, error: 'Parse error' }; }
            onDone(data);
        };
        req.send(params);
    }

    var testBtn  = document.getElementById('prod-test-btn');
    var statusEl = document.getElementById('prod-connect-status');
    var nextBtn  = document.getElementById('acc-next-btn');

    if (nextBtn) nextBtn.href = NEXT_URL;

    testBtn.addEventListener('click', function () {
        testBtn.disabled    = true;
        testBtn.textContent = 'Testing…';
        statusEl.textContent = '';
        statusEl.style.color = '#54698d';

        var form   = document.getElementById('prod-connect-form');
        var inputs = form.querySelectorAll('input[name]');
        var params = '';
        for (var i = 0; i < inputs.length; i++) {
            if (params) params += '&';
            params += encodeURIComponent(inputs[i].name) + '=' + encodeURIComponent(inputs[i].value);
        }

        post(TEST_URL, params, function (data) {
            testBtn.disabled    = false;
            testBtn.textContent = 'Test Connection';
            if (data.ok) {
                statusEl.textContent = '✔ Connected' + (data.project ? ' — project: ' + data.project : '');
                statusEl.style.color = '#2e7d32';
            } else {
                statusEl.textContent = '✖ ' + (data.error || 'Connection failed');
                statusEl.style.color = '#c62828';
            }
        });
    });
}());
</script>
