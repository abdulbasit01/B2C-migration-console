<section class="acc-step-panel">
    <h2 class="acc-step-panel__title">
        Step <isprint value="${pdict.currentStep}" formatter="#"/> &mdash; <span class="acc-highlight">${pdict.stepContent.titleSuffix}</span>
    </h2>
    <p class="acc-step-panel__intro"></p>

    <isif condition="${pdict.stepContent.groups.length === 0}">
        <div class="acc-callout acc-callout--error">
            Please go back to Step 1 and enter valid Shopify credentials before continuing.
        </div>
    </isif>
    <isloop items="${pdict.stepContent.groups}" var="group">
        <div class="acc-mapping-group">
            <div class="acc-mapping-group__head">
                <h3 class="acc-mapping-group__title">
                    <span class="acc-mapping-group__icon">&#9776;</span>
                    ${group.title}
                    <span class="acc-mapping-group__total"><isprint value="${group.total}" formatter="#"/> attrs</span>
                </h3>
                <div class="acc-mapping-group__badges">
                    <isif condition="${group.existsCount > 0}">
                        <span class="acc-badge acc-badge--exists">&#10003; <isprint value="${group.existsCount}" formatter="#"/> migrated</span>
                    </isif>
                    <isif condition="${group.newCount > 0}">
                        <span class="acc-badge acc-badge--new">+ <isprint value="${group.newCount}" formatter="#"/> new</span>
                    </isif>
                </div>
            </div>
            <table class="acc-table acc-table--compact">
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Source field</th>
                        <th>Type supported SFCC</th>
                        <th style="padding-left:28px">Target Attribute ID</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    <isloop items="${group.mappings}" var="row">
                        <tr class="${row.sfccNativeAction === 'skip' ? 'acc-row--skip' : (row.exists ? 'acc-row--exists' : 'acc-row--new')}">
                            <td>
                                <isif condition="${row.sfccNativeAction === 'skip'}">
                                    <span class="acc-badge acc-badge--skip">&#8856; skipped</span>
                                <iselseif condition="${row.exists}"/>
                                    <span class="acc-badge acc-badge--exists">&#10003; migrated</span>
                                <iselse/>
                                    <span class="acc-badge acc-badge--new">+ new</span>
                                </isif>
                            </td>
                            <td><code>${row.source}</code></td>
                            <td><code>${row.target}</code></td>
                            <td style="padding-left:28px"><code>${row.attributeId}</code></td>
                            <td>
                                <isif condition="${row.sfccNativeNote != null}">
                                    <span class="acc-info-tip" aria-label="${row.sfccNativeNote}">
                                        &#9432;
                                        <span class="acc-info-tip__text">${row.sfccNativeNote}</span>
                                    </span>
                                </isif>
                            </td>
                        </tr>
                    </isloop>
                </tbody>
            </table>
        </div>
    </isloop>
</section>
