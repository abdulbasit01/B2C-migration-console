<section class="acc-step-panel">
    <h2 class="acc-step-panel__title">
        Step ${pdict.currentStep} &mdash; <span class="acc-highlight">${pdict.stepContent.titleSuffix}</span>
    </h2>
    <p class="acc-step-panel__intro">${pdict.stepContent.intro}</p>

    <div id="acc-move-status" style="display:none;" class="acc-callout acc-callout--info" style="margin-bottom:16px;"></div>

    <ul class="acc-phases" id="acc-phase-list">
        <isloop items="${pdict.stepContent.selectedTasks}" var="task">
            <li class="acc-phases__item acc-phases__item--pending" id="acc-phase-${task}">
                <div class="acc-phases__head">
                    <span>${task}</span>
                    <span class="acc-phases__status" id="acc-status-${task}">pending</span>
                </div>
                <p class="acc-phases__detail" id="acc-detail-${task}"></p>
                <div class="acc-progress">
                    <div class="acc-progress__bar" id="acc-bar-${task}" style="width:0%"></div>
                </div>
            </li>
        </isloop>
    </ul>

    <div class="acc-move-actions">
        <button type="button" id="acc-start-btn" class="acc-btn acc-btn--primary">
            &#9654; Start Migration
        </button>
        <span id="acc-move-overall" style="margin-left:14px;font-size:13px;color:#54698d;"></span>
    </div>
</section>

<script>
(function () {
    var MIGRATE_URL  = '${pdict.stepContent.migrateUrl}';
    var EXISTING_URL = '${URLUtils.url("Accelerator-GetExistingAttrs")}';
    var SAVE_URL     = '${URLUtils.url("Accelerator-SaveMigrationResults")}';
    var TASKS        = [<isloop items="${pdict.stepContent.selectedTasks}" var="t" status="ls">'${t}'<isif condition="${!ls.last}">, </isif></isloop>];
    var taskIndex    = 0;
    var totalCreated = 0;
    var totalFailed  = 0;
    var taskStats    = {};   // { TaskName: { created: N, failed: N } }
    var running      = false;

    var startBtn  = document.getElementById('acc-start-btn');
    var overallEl = document.getElementById('acc-move-overall');
    var statusBox = document.getElementById('acc-move-status');

    function setPhaseState(task, state, detail, pct) {
        var li     = document.getElementById('acc-phase-' + task);
        var status = document.getElementById('acc-status-' + task);
        var detEl  = document.getElementById('acc-detail-' + task);
        var bar    = document.getElementById('acc-bar-' + task);
        if (!li) return;
        li.className           = 'acc-phases__item acc-phases__item--' + state;
        if (status) status.textContent = state;
        if (detEl)  detEl.textContent  = detail || '';
        if (bar)    bar.style.width    = (pct || 0) + '%';
    }

    function fetchExisting(task, onDone) {
        setPhaseState(task, 'active', 'Checking existing attributes in SFCC…', 0);
        var xhr = new XMLHttpRequest();
        xhr.open('POST', EXISTING_URL, true);
        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        xhr.onreadystatechange = function () {
            if (xhr.readyState !== 4) return;
            var data;
            try { data = JSON.parse(xhr.responseText); } catch (e) { data = { ok: false }; }
            taskStats[task].existingCount = (data.ok && data.count) ? data.count : 0;
            onDone();
        };
        xhr.send('task=' + encodeURIComponent(task));
    }

    function runTask(task, offset) {
        if (!taskStats[task]) taskStats[task] = { created: 0, failed: 0, skipped: 0, total: 0, existingCount: 0 };

        var xhr = new XMLHttpRequest();
        xhr.open('POST', MIGRATE_URL, true);
        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        xhr.onreadystatechange = function () {
            if (xhr.readyState !== 4) return;
            var data;
            try { data = JSON.parse(xhr.responseText); } catch (e) { data = { ok: false, error: 'Parse error' }; }

            if (!data.ok) {
                setPhaseState(task, 'error', data.error || 'Failed', 0);
                nextTask();
                return;
            }

            taskStats[task].created += (data.created || 0);
            taskStats[task].failed  += (data.failed  || 0);
            taskStats[task].total    = data.total     || 0;
            if (data.errors && data.errors.length) {
                taskStats[task].errors = (taskStats[task].errors || []).concat(data.errors);
            }

            totalCreated = 0;
            totalFailed  = 0;
            for (var t in taskStats) {
                totalCreated += Math.max(0, taskStats[t].created - taskStats[t].existingCount);
                totalFailed  += taskStats[t].failed;
            }

            var pct = (data.total > 0) ? Math.round((data.nextOffset / data.total) * 100) : 100;
            var ts  = taskStats[task];
            var genuineNew = Math.max(0, ts.created - ts.existingCount);
            var inProgress = ts.existingCount + ' already in SFCC — ' + genuineNew + ' new, processing…';
            overallEl.textContent = 'New attributes created: ' + totalCreated + (totalFailed ? ', failed: ' + totalFailed : '');

            if (!data.done) {
                setPhaseState(task, 'active', inProgress, pct);
                runTask(task, data.nextOffset);
            } else {
                var finalNew    = Math.max(0, ts.created - ts.existingCount);
                var finalState  = ts.failed > 0 && finalNew === 0 ? 'error'
                                : ts.failed > 0 ? 'warning'
                                : 'done';
                var finalDetail = ts.existingCount + ' already existed — '
                    + finalNew + ' new attribute(s) created'
                    + (ts.failed > 0 ? ', ' + ts.failed + ' failed' : '');
                if (ts.errors && ts.errors.length) {
                    finalDetail += ' | ' + ts.errors.slice(0, 2).join('; ');
                }
                setPhaseState(task, finalState, finalDetail, 100);
                nextTask();
            }
        };
        xhr.send('task=' + encodeURIComponent(task) + '&offset=' + offset);
    }

    function startTask(index) {
        var task = TASKS[index];
        taskStats[task] = { created: 0, failed: 0, skipped: 0, total: 0, existingCount: 0, errors: [] };
        fetchExisting(task, function () { runTask(task, 0); });
    }

    function saveResults() {
        var payload = {};
        for (var t in taskStats) {
            payload[t] = {
                created: taskStats[t].created,
                skipped: taskStats[t].skipped,
                failed:  taskStats[t].failed
                // createdIds omitted — too large for session.custom (2000 char limit)
            };
        }
        var xhr = new XMLHttpRequest();
        xhr.open('POST', SAVE_URL, true);
        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        xhr.send('results=' + encodeURIComponent(JSON.stringify(payload)));
    }

    function nextTask() {
        taskIndex++;
        if (taskIndex >= TASKS.length) {
            running = false;
            saveResults();
            startBtn.disabled    = false;
            startBtn.textContent = '✔ Migration Complete';
            statusBox.style.display = 'block';
            statusBox.className     = totalFailed > 0 ? 'acc-callout acc-callout--error' : 'acc-callout acc-callout--success';
            statusBox.textContent   = 'Migration finished — '
                + totalCreated + ' new attribute(s) created'
                + (totalFailed ? ', ' + totalFailed + ' failed' : '') + '.';
            return;
        }
        startTask(taskIndex);
    }

    startBtn.addEventListener('click', function () {
        if (running) return;
        running      = true;
        taskIndex    = 0;
        totalCreated = 0;
        totalFailed  = 0;
        taskStats    = {};
        startBtn.disabled    = true;
        startBtn.textContent = 'Running…';
        statusBox.style.display = 'none';
        startTask(0);
    });
}());
</script>
