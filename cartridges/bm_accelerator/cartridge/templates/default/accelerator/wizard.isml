<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>${pdict.title} — ${pdict.platform.name}</title>
    <link rel="stylesheet" href="${pdict.cssUrl}"/>
</head>
<body class="acc-page acc-page--wizard">
    <div class="acc-shell">
        <isinclude template="accelerator/components/header"/>

        <a class="acc-back" href="${pdict.dashboardUrl}">
            &larr; ${Resource.msg('accelerator.wizard.back', 'accelerator', null)}
        </a>

        <isinclude template="accelerator/components/stepper"/>

        <main class="acc-wizard-card">
            <isif condition="${pdict.wizardStep.key === 'connect'}">
                <isinclude template="accelerator/components/stepConnect"/>
            <iselseif condition="${pdict.wizardStep.key === 'fetch'}"/>
                <isinclude template="accelerator/components/stepFetch"/>
            <iselseif condition="${pdict.wizardStep.key === 'aimap'}"/>
                <isinclude template="accelerator/components/stepAiMap"/>
            <iselseif condition="${pdict.wizardStep.key === 'move'}"/>
                <isinclude template="accelerator/components/stepMove"/>
            <iselse/>
                <isinclude template="accelerator/components/stepView"/>
            </isif>
        </main>

        <footer class="acc-wizard-footer">
            <isif condition="${pdict.prevStep}">
                <a class="acc-btn acc-btn--ghost"
                   href="${pdict.wizardBaseUrl}&amp;step=${pdict.prevStep}">
                    &larr; ${Resource.msg('accelerator.wizard.previous', 'accelerator', null)}
                </a>
            <iselse/>
                <span></span>
            </isif>

            <isif condition="${pdict.isLastStep}">
                <a class="acc-btn acc-btn--primary" href="${pdict.dashboardUrl}">
                    ${pdict.nextStepLabel} &rarr;
                </a>
            <iselseif condition="${pdict.nextStep}"/>
                <a class="acc-btn acc-btn--primary"
                   href="${pdict.wizardBaseUrl}&amp;step=${pdict.nextStep}">
                    ${pdict.nextStepLabel} &rarr;
                </a>
            </isif>
        </footer>
    </div>
</body>
</html>
