{
    "step-types": {
        "script-module-step": [{
            "@type-id": "custom.ImportCtpCustomers",
            "description": "Import CTP customers from XML files uploaded by migration tool (reads from /Impex/src/migration/customer/)",
            "module": "bm_accelerator/cartridge/scripts/jobsteps/importCtpCustomers",
            "function": "execute",
            "transactional": false,
            "parameters": {
                "parameter": [
                    {
                        "@name": "ImportDirectory",
                        "@type": "String",
                        "@required": "false",
                        "description": "Directory under /Impex/ containing customer XML files (default: src/migration/customer)",
                        "default-value": "src/migration/customer"
                    },
                    {
                        "@name": "CustomerListID",
                        "@type": "String",
                        "@required": "false",
                        "description": "SFCC Customer List ID to import customers into — used as fallback if config.json is absent",
                        "default-value": ""
                    }
                ]
            }
        }]
    }
}
