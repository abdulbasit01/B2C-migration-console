# ── Shopify source (if migrating from Shopify) ──────────────────────────────
SHOPIFY_STORE_URL=https://your-store.myshopify.com
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=shpss_your-client-secret
SHOPIFY_API_VERSION=2026-01
# Legacy: SHOPIFY_ACCESS_TOKEN=shpss_your-access-token

# ── Commercetools source (if migrating from commercetools) ───────────────────
# copy to .env and fill before npm run config:generate
CTP_PROJECT_KEY=your-project-key
CTP_CLIENT_ID=your-client-id
CTP_CLIENT_SECRET=your-client-secret
CTP_AUTH_URL=https://auth.us-central1.gcp.commercetools.com
CTP_API_URL=https://api.us-central1.gcp.commercetools.com

# SFCC schema migration targets
SFCC_BM_CLIENT_ID=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
SFCC_VERSION=v25_6
SFCC_META_VERSION=v25_6
SFCC_CATALOG_ID=storefront-catalog-m-en
SFCC_INVENTORY_LIST_ID=migrated-inventory

# Optional
BATCH_SIZE=20
DRY_RUN=false

# ── Amplience CMS (storefront content migration) ─────────────────────────────
AMPLIENCE_HUB_NAME=my-brand
# Recommended for developer trial — create under Dynamic Content → Development → Personal Access Tokens
AMPLIENCE_PERSONAL_ACCESS_TOKEN=amp_pat_your-token-here
# Alternative: API key + secret (provided by Amplience support, not from the docs page)
AMPLIENCE_CLIENT_ID=
AMPLIENCE_CLIENT_SECRET=
AMPLIENCE_DEFAULT_DELIVERY_KEY=home-banner
